# Server Configuration
PORT=3000
NODE_ENV=development

# Security (обязательно в production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password_immediately

# Database
# Локально: file или postgresql
# DATABASE_URL="postgresql://user:password@localhost:5432/template_site?schema=public"
DATABASE_URL="file:./dev.db"

# PostgreSQL (для Docker / production — задайте в .env)
# POSTGRES_USER=template_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=template_site

# Client origins
PUBLIC_SITE_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:4173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Uploads
UPLOADS_DIR=uploads

# Logs (корневой каталог логов, монтируется в контейнер API)
# LOGS_ROOT_DIR=/logs-host

# Rate limit (опционально)
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_POINTS=10000
# RATE_LIMIT_WINDOW=60

{
  "name": "template-site-frontend",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Template storefront frontend",
  "scripts": {
    "vite:dev:admin": "VITE_APP_ENTRY=/src/main.tsx vite",
    "vite:build:admin": "VITE_APP_ENTRY=/src/main.tsx node ./node_modules/typescript/bin/tsc && VITE_APP_ENTRY=/src/main.tsx node ./node_modules/vite/bin/vite.js build",
    "bundle:storefront": "VITE_APP_ENTRY=/src/main.public.tsx node ./node_modules/typescript/bin/tsc && VITE_APP_ENTRY=/src/main.public.tsx node ./node_modules/vite/bin/vite.js build",
    "vite:preview": "vite preview",
    "vite:serve:public": "node ./scripts/serve-public.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "eslint:check": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "eslint:fix": "eslint src --ext ts,tsx --fix",
    "prettier:write": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "tsc:check": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:uploads-bootstrap": "node ./scripts/validate-bootstrap-uploads.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.2",
    "@types/reveal.js": "^5.2.2",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "reveal.js": "^6.0.2",
    "sharp": "^0.35.4",
    "swiper": "^14.2.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "express": "^5.2.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}

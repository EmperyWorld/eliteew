{
  "name": "eliteew-desktop-client",
  "private": true,
  "license": "MIT",
  "version": "0.5.37",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:linux": "bash scripts/ensure-linux-build-deps.sh && tauri build --bundles rpm",
    "build:linux:updater": "bash scripts/ensure-linux-build-deps.sh && tauri build --bundles rpm --config src-tauri/tauri.conf.signing.example.json",
    "build:linux:fofline": "bash scripts/build-linux-fofline.sh",
    "build:linux:fofline:updater": "bash scripts/build-linux-fofline.sh --with-signing-config",
    "build:windows": "tauri build --bundles nsis",
    "build:windows:fofline": "tauri build --bundles nsis --config src-tauri/tauri.conf.fofline.example.json --config src-tauri/tauri.windows.conf.json --config src-tauri/tauri.conf.fofline.windows.example.json",
    "build:windows:fofline:updater": "tauri build --bundles nsis --config src-tauri/tauri.conf.fofline.example.json --config src-tauri/tauri.windows.conf.json --config src-tauri/tauri.conf.fofline.windows.example.json --config src-tauri/tauri.conf.signing.example.json",
    "bundle": "bash scripts/bundle.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:wireguard-msi": "bash packaging/windows/fetch-wireguard-msi.sh"
  },
  "dependencies": {
    "@eliteew/kernel-offline-policy": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}

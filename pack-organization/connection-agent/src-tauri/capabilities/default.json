{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-launcher",
  "description": "Local launcher main window with explicit command ACL and scoped external links.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-create-webview-window",
    "allow-launcher-open-external",
    "core:window:allow-set-focus",
    "allow-desktop-client-ping",
    "allow-host-network-status",
    "allow-host-network-link-snapshot",
    "allow-host-network-wired-apply",
    "allow-host-network-wifi-scan",
    "allow-host-network-wifi-connect",
    "allow-host-network-wifi-disconnect",
    "allow-license-status",
    "allow-license-local-factory-reset-prepare",
    "allow-license-local-factory-reset",
    "allow-device-identity-status",
    "allow-device-identity-ensure",
    "allow-device-request-prepare",
    "allow-device-request-status",
    "allow-device-bind-status",
    "allow-device-bind-ensure",
    "allow-entitlement-status",
    "allow-license-preflight-cmd",
    "allow-license-heartbeat-cmd",
    "allow-entitlement-import-json",
    "allow-entitlement-import-from-grant",
    "allow-file-grant-issue",
    "allow-file-grant-pick",
    "allow-capsule-import-channel",
    "allow-capsule-import-pick-file",
    "allow-air-enroll-exchange",
    "allow-sealed-peer-load",
    "allow-sealed-peer-clear",
    "allow-w-transport-l7-probe",
    "allow-w-transport-status-cmd",
    "allow-w-transport-proxy-url-cmd",
    "allow-w-transport-start-from-keyring",
    "allow-w-transport-recover-from-keyring",
    "allow-w-transport-stop-cmd",
    "allow-product-open",
    "allow-fofline-local-start-url",
    "allow-product-webview-wipe",
    "allow-product-close-for-license-kill-switch-cmd",
    "allow-native-oidc-start",
    "allow-native-oidc-complete",
    "allow-native-oidc-refresh",
    "allow-native-oidc-logout",
    "allow-native-oidc-interactive-login",
    "allow-kernel-offline-open-mount",
    "allow-updater-check",
    "allow-updater-install",
    "allow-updater-recovery-install",
    "allow-fofline-spa-pack-status",
    "allow-fofline-spa-pack-check-update",
    "allow-fofline-spa-pack-sync",
    "allow-fofline-spa-assets-sync",
    "allow-fofline-spa-assets-cancel",
    "allow-webkit-graphics-status",
    "allow-webkit-graphics-reset",
    "allow-app-restart",
    "allow-ai-local-status",
    "allow-ai-local-chat",
    "allow-ai-third-party-status",
    "allow-ai-third-party-save-settings",
    "allow-ai-third-party-save-api-key",
    "allow-ai-third-party-clear-api-key",
    "allow-ai-third-party-chat",
    "allow-ai-eliteew-status",
    "allow-ai-eliteew-chat",
    "allow-denylist-status",
    "allow-denylist-refresh",
    "allow-clipboard-status",
    "allow-clipboard-read",
    "allow-clipboard-write",
    "allow-fs-bridge-roots",
    "allow-fs-bridge-list-dir",
    "allow-fs-bridge-read-file",
    "allow-fs-bridge-write-atomic",
    "allow-notifications-list",
    "allow-notifications-add",
    "allow-notifications-dismiss",
    "allow-native-audio-play-from-grant",
    "allow-native-audio-pause",
    "allow-native-audio-resume",
    "allow-native-audio-stop",
    "allow-native-audio-seek",
    "allow-native-audio-set-volume",
    "allow-native-audio-status"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "product-webview",
  "description": "Local product WebView — only explicitly product-scoped native commands.",
  "local": true,
  "windows": [
    "product"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-focus",
    "core:webview:allow-clear-all-browsing-data",
    "allow-clipboard-status",
    "allow-clipboard-read",
    "allow-clipboard-write",
    "allow-notifications-list",
    "allow-notifications-add",
    "allow-notifications-dismiss",
    "allow-native-audio-pause",
    "allow-native-audio-resume",
    "allow-native-audio-stop",
    "allow-native-audio-seek",
    "allow-native-audio-set-volume",
    "allow-native-audio-status",
    "allow-product-session-refresh",
    "allow-product-session-logout",
    "allow-host-network-link-snapshot",
    "allow-video-call-meet-stage-open",
    "allow-video-call-meet-stage-set-bounds",
    "allow-video-call-meet-stage-close",
    "allow-ebrowser-open",
    "allow-ebrowser-navigate",
    "allow-ebrowser-refresh-policy",
    "allow-ebrowser-get-location",
    "allow-ebrowser-get-chrome-snapshot",
    "allow-ebrowser-reload",
    "allow-ebrowser-history-back",
    "allow-ebrowser-history-forward",
    "allow-ebrowser-set-bounds",
    "allow-ebrowser-close",
    "allow-ebrowser-get-downloads",
    "allow-ebrowser-tabs-list",
    "allow-ebrowser-tab-create",
    "allow-ebrowser-tab-activate",
    "allow-ebrowser-tab-close",
    "allow-ebrowser-set-media-toggles",
    "allow-ebrowser-get-media-toggles",
    "allow-ebrowser-find",
    "allow-ebrowser-set-zoom",
    "allow-ebrowser-get-zoom"
  ]
}

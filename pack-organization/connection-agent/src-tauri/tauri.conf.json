{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EliteEW Desktop Client",
  "mainBinaryName": "eliteew-desktop-client",
  "version": "0.5.37",
  "identifier": "world.empery.desktop.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Рабочий стол EliteEW",
        "width": 920,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://app.eliteew.ru https://auth.eliteew.ru; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/96x96.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "desktopTemplate": "../packaging/linux/desktop-template.desktop",
        "postInstallScript": "../packaging/linux/rpm-postinstall.sh",
        "postRemoveScript": "../packaging/linux/rpm-postremove.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQjYwNUI3MzZDNUNEODMKUldTRHpjVTJ0d1cya3h5TmNmV29NYjhTMTJEZVEwTmJaZVh4eWRvb3BtaTUwVko2MnpibGxwOTkK",
      "endpoints": [
        "https://app.eliteew.ru/desktop-client-updates/latest.json"
      ]
    },
    "eliteew-desktop-client": {
      "product_id": "world.empery.desktop.client",
      "channel": "connected",
      "package_id": "elite-ew-desktop-client",
      "package_type": "rpm",
      "metadata_key_id": "connected-meta-1",

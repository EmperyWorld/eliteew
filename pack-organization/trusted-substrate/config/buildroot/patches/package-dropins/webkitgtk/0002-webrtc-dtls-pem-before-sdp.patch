+static gboolean dtlsAcceptPeerCertificate(gpointer, const gchar*, gpointer)
+{
+    return TRUE;
+}
+
+static void dtlsBindPeerCertificateAccept(gpointer object)
+{
+    if (!object || !g_signal_lookup("on-peer-certificate", G_OBJECT_TYPE(object)))
+        return;
+    g_signal_connect(object, "on-peer-certificate", G_CALLBACK(dtlsAcceptPeerCertificate), nullptr);
+}
+
+static void dtlsBindPeerCertificateAcceptRecursive(GstElement* root)
+{
+    if (!root)
+        return;
+    dtlsBindPeerCertificateAccept(root);
+    if (!GST_IS_BIN(root))
+        return;
+    GstIterator* it = gst_bin_iterate_recurse(GST_BIN_CAST(root));
+    GValue item = G_VALUE_INIT;
+    while (gst_iterator_next(it, &item) == GST_ITERATOR_OK) {
+        dtlsBindPeerCertificateAccept(g_value_get_object(&item));
+        g_value_reset(&item);
+    }
+    gst_iterator_free(it);
+}
+
+static void dtlsApplyPemAndAccept(GstElement* element, const String& pem)
+{
+    if (!element || pem.isEmpty())
+        return;
+    if (!g_object_class_find_property(G_OBJECT_GET_CLASS(element), "pem"))
+        return;
+    g_object_set(element, "pem", pem.utf8().data(), nullptr);
+    dtlsBindPeerCertificateAcceptRecursive(element);
+}

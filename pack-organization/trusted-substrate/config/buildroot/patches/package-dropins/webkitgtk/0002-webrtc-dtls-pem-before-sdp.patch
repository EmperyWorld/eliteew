+void GStreamerMediaEndpoint::ensureDtlsCertificatePem(const Vector<MediaEndpointConfiguration::CertificatePEM>& certificates)
+{
+    if (!certificates.isEmpty()) {
+        const auto& pem = certificates[0];
+        m_dtlsCertificatePem = makeString(pem.certificate, pem.privateKey);
+        GST_INFO_OBJECT(m_pipeline.get(), "Using configured DTLS certificate PEM (length %u)", m_dtlsCertificatePem.length());
+        return;
+    }
+    if (!m_dtlsCertificatePem.isEmpty())
+        return;
+
+    auto backend = peerConnectionBackend();
+    if (!backend)
+        return;
+    auto* context = backend->connection().scriptExecutionContext();
+    if (!context)
+        return;
+    auto& document = downcast<Document>(*context);
+    auto generated = generateCertificate(document.securityOrigin(), PeerConnectionBackend::CertificateInformation::ECDSA_P256());
+    if (!generated) {
+        GST_WARNING_OBJECT(m_pipeline.get(), "Failed to generate DTLS certificate PEM");
+        return;
+    }
+    Ref<RTCCertificate> certificate = WTF::move(*generated);
+    m_dtlsCertificatePem = makeString(certificate->pemCertificate(), certificate->pemPrivateKey());
+    GST_INFO_OBJECT(m_pipeline.get(), "Generated DTLS PEM for webrtcbin (length %u)", m_dtlsCertificatePem.length());
+}
+
+void GStreamerMediaEndpoint::applyDtlsCertificateOnTransport(gpointer transport)
+{
+    if (!transport || m_dtlsCertificatePem.isEmpty())
+        return;
+    if (!GST_IS_WEBRTC_DTLS_TRANSPORT(transport))
+        return;
+    g_object_set(transport, "certificate", m_dtlsCertificatePem.utf8().data(), nullptr);
+}
+
+void GStreamerMediaEndpoint::applyDtlsCertificateOnTransceiver(GstWebRTCRTPTransceiver* transceiver)
+{
+    if (!transceiver)
+        return;
+    GRefPtr<GstWebRTCRTPSender> sender;
+    GRefPtr<GstWebRTCRTPReceiver> receiver;
+    g_object_get(transceiver, "sender", &sender.outPtr(), "receiver", &receiver.outPtr(), nullptr);
+    if (sender) {
+        GRefPtr<GstWebRTCDTLSTransport> dtls;
+        g_object_get(sender.get(), "transport", &dtls.outPtr(), nullptr);
+        applyDtlsCertificateOnTransport(dtls.get());
+    }
+    if (receiver) {
+        GRefPtr<GstWebRTCDTLSTransport> dtls;
+        g_object_get(receiver.get(), "transport", &dtls.outPtr(), nullptr);
+        applyDtlsCertificateOnTransport(dtls.get());
+    }
+}
+
+void GStreamerMediaEndpoint::applyDtlsCertificatePem()
+{
+    if (!m_webrtcBin || m_dtlsCertificatePem.isEmpty())
+        return;
+    forEachTransceiver(m_webrtcBin, [&](auto&& transceiver) -> bool {
+        applyDtlsCertificateOnTransceiver(transceiver.get());
+        return false;
+    });
+    GRefPtr<GstWebRTCSCTPTransport> sctp;
+    g_object_get(m_webrtcBin.get(), "sctp-transport", &sctp.outPtr(), nullptr);
+    if (sctp) {
+        GRefPtr<GstWebRTCDTLSTransport> dtls;
+        g_object_get(sctp.get(), "transport", &dtls.outPtr(), nullptr);
+        applyDtlsCertificateOnTransport(dtls.get());
+    }
+    dtlsBindPeerCertificateAcceptRecursive(m_webrtcBin.get());
+}
+
 GstElement* GStreamerMediaEndpoint::requestAuxiliarySender(GRefPtr<GstWebRTCDTLSTransport>&& transport)
 {
+    applyDtlsCertificateOnTransport(transport.get());
     // Don't use makeGStreamerElement() here because it would be called mutiple times and emit an
     // error every single time if the element is not found.
     auto* estimator = gst_element_factory_make("rtpgccbwe", nullptr);

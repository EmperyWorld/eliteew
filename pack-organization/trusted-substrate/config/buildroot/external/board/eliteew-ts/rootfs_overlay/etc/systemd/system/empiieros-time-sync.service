[Unit]
Description=EmpiierOS set operator wall clock
Documentation=file:///opt/empiieros/docs/RUNTIME.md
RefuseManualStart=false
ConditionPathExists=/usr/local/sbin/empiieros-time-sync
ConditionPathExists=/run/empiieros/time-sync.request

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/empiieros-time-sync
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# This unit writes the operator clock. Do not set ProtectClock.
# Do not enable timesyncd. Public NTP stays masked.

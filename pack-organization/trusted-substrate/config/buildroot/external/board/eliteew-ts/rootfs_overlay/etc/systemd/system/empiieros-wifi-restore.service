[Unit]
Description=Restore persisted EmpiierOS Wi-Fi profiles
After=systemd-networkd.service
Wants=systemd-networkd.service
Before=network-online.target
ConditionDirectoryNotEmpty=/etc/wpa_supplicant
# Live USB must not replay a leftover PSK from a previous glass/install.
ConditionPathExists=!/etc/eliteew-trusted-substrate/live-installer

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/empiieros-wifi-restore
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# This unit may rebind ath10k_pci through sysfs after a firmware-timing miss.
# Do not set ProtectKernelTunables.
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
# ip/iw association wait needs netlink; systemctl stays on AF_UNIX.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target

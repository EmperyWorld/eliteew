[Unit]
Description=EmpiierOS state LUKS console unlock agent
Documentation=file:///opt/eliteew-trusted-substrate/README-FIRST.txt
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=cryptsetup.target getty@tty1.service
Conflicts=shutdown.target emergency.service systemd-ask-password-console.service
Before=shutdown.target emergency.service

[Service]
Type=simple
ExecStart=/usr/local/bin/empiieros-state-unlock-agent --watch
Restart=on-failure
RestartSec=1
StandardInput=tty
TTYPath=/dev/console
Environment=LANG=ru_RU.UTF-8
Environment=LC_ALL=ru_RU.UTF-8
Environment=XKB_DEFAULT_LAYOUT=us,ru
Environment=XKB_DEFAULT_OPTIONS=grp:alt_shift_toggle

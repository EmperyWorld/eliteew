[Unit]
Description=EmpiierOS allowlisted WLAN rfkill
Documentation=file:///opt/empiieros/docs/RUNTIME.md
RefuseManualStart=false
ConditionPathExists=/usr/local/sbin/empiieros-wifi-radio
ConditionPathExists=/run/empiieros/wifi-radio.request

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/empiieros-wifi-radio
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
# This unit must write /sys/class/rfkill. Do not set ProtectKernelTunables.

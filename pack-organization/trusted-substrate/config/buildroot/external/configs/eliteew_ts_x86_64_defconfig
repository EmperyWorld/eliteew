# EliteEW Trusted Substrate defconfig — generated from ordered fragments
# SoT fragments: config/buildroot/fragments/

# EliteEW Trusted Substrate — x86_64 base (merged with fragments by buildroot-build.sh)
# W3 HOSTCC builds Buildroot's from-source toolchain + packages (see docs/ROOTFS-FROM-SOURCE.md).

BR2_x86_64=y
BR2_ARCH_IS_64=y
BR2_ENDIAN="LITTLE"
BR2_GCC_TARGET_ABI="64"
BR2_GCC_TARGET_CPU="x86-64"
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_12=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

BR2_TARGET_GENERIC_HOSTNAME="eliteew-ts"
BR2_TARGET_GENERIC_ISSUE="EliteEW Trusted Substrate"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_SYSTEM_DHCP="eth0"
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y
# libseccomp selects systemd meson -Dseccomp=enabled on the next image rebuild.
BR2_PACKAGE_LIBSECCOMP=y
BR2_PACKAGE_BUSYBOX=y

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ELITEEW_TS_PATH)/board/eliteew-ts/linux-console.fragment $(BR2_EXTERNAL_ELITEEW_TS_PATH)/board/eliteew-ts/linux-gpu-audio.fragment $(BR2_EXTERNAL_ELITEEW_TS_PATH)/board/eliteew-ts/linux-wifi.fragment $(BR2_EXTERNAL_ELITEEW_TS_PATH)/board/eliteew-ts/linux-security.fragment $(BR2_EXTERNAL_ELITEEW_TS_PATH)/board/eliteew-ts/linux-wireguard.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# WebKitGTK + Mesa + LLVM/radeonsi + amdgpu firmware need headroom beyond 8G.
BR2_TARGET_ROOTFS_EXT2_SIZE="12G"
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y

# Toolchain / overlay paths are injected by scripts/buildroot-build.sh
# Minimal userspace for kiosk + WG handoff (explicit enables only).
BR2_PACKAGE_UTIL_LINUX=y
# lsblk/sfdisk/wipefs/findmnt — live apply disk path (NOT covered by UTIL_LINUX alone).
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# Buildroot still passes --disable-wipefs unless this is set (overrides --enable-all-programs).
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_E2FSPROGS=y
# LUKS2 state slot (apply + systemd-cryptsetup). Never bake a passphrase.
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WIRELESS_REGDB=y
# Firmware matching the common laptop drivers enabled by linux-wifi.fragment.
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA9377=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA998X=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_GETENT=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_HAVEGED=y
BR2_PACKAGE_LIBMNL=y
BR2_PACKAGE_LIBNFTNL=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBCAP=y
BR2_PACKAGE_ACL=y
BR2_PACKAGE_ATTR=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_TZDATA=y
BR2_GENERATE_LOCALE="en_US.UTF-8 ru_RU.UTF-8"
BR2_ENABLE_LOCALE_WHITELIST="C en_US ru_RU"
# Installer disk health and identity probes.
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_NVME=y
# Seat wall clock default (RU product); Desktop shell may still override display TZ.
BR2_TARGET_LOCALTIME="Europe/Moscow"
# NTP client is systemd-timesyncd (enabled in rootfs_overlay + post-build). Do not add chrony.
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y
BR2_PACKAGE_SHADOW=y
BR2_PACKAGE_PCRE2=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_GRUB2=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_GRUB2_X86_64_EFI=y
# Tauri / Wayland kiosk display stack (metal kinship: labwc + WebKit/GTK).
# payload_trust=tauri-living — Desktop Client is overlay/slot payload (not Electron).
# labwc comes from BR2_EXTERNAL (stock Buildroot has cage/weston only).

BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_MTDEV=y

BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_WLROOTS_XWAYLAND=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_LABWC=y
BR2_PACKAGE_LABWC_XWAYLAND=y
BR2_PACKAGE_PSMISC=y

BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBDRM_AMDGPU=y

# X.org bits required for Xwayland (Tauri/X11 fallback clients under Wayland).
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_LIBXCB=y
BR2_PACKAGE_XCB_UTIL_WM=y
BR2_PACKAGE_XCB_UTIL_RENDERUTIL=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_XLIB_LIBXI=y
BR2_PACKAGE_XLIB_LIBXCURSOR=y
BR2_PACKAGE_XLIB_LIBXFIXES=y
BR2_PACKAGE_XLIB_LIBXCOMPOSITE=y
BR2_PACKAGE_XLIB_LIBXDAMAGE=y
BR2_PACKAGE_XLIB_LIBXXF86VM=y
BR2_PACKAGE_XLIB_LIBXSHMFENCE=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y

BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_CAIRO_PNG=y
BR2_PACKAGE_PANGO=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_WAYLAND=y
BR2_PACKAGE_LIBGTK3_X11=y
BR2_PACKAGE_LIBSECRET=y
# Secret Service provider for device_request_prepare (not in stock BR 2025.02.1).
BR2_PACKAGE_LIBCAP_NG=y
BR2_PACKAGE_GCR=y
BR2_PACKAGE_GNOME_KEYRING=y
BR2_PACKAGE_GSETTINGS_DESKTOP_SCHEMAS=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_DESKTOP_FILE_UTILS=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
# Adwaita / GCR drop icons into hicolor/; without the theme index,
# gtk-update-icon-cache aborts with "No theme index file".
BR2_PACKAGE_HICOLOR_ICON_THEME=y

# WebKitGTK — runtime for living Tauri Linux WebView (engine-from-source = W8 label later).
BR2_PACKAGE_WEBKITGTK=y
BR2_PACKAGE_WEBKITGTK_HTTPS=y
BR2_PACKAGE_WEBKITGTK_SANDBOX=y
# EmpiierOS Meet/Jitsi: stock webkitgtk.mk hardcodes ENABLE_WEB_RTC=OFF.
# Multimedia pulls GStreamer; webrtcbin + opus + v4l2 are the Meet path.
# webrtcbin_init factory_make("rtpbin") needs gst-plugins-good rtpmanager;
# rtpfunnel lives in the RTP plugin. Without them the WebProcess SIGSEGVs
# on GST_OBJECT_LOCK(NULL) (glib 8d317) when the second peer joins.
# WebKit outgoing audio/video always factory_make audiotestsrc /
# videotestsrc (silence/black fallback) and videorate (RTP packetizer).
# clocksync is already in gstreamer coreelements, not a separate .so.
# AudioSourceProvider / AudioFileReader factory_make("deinterleave")
# with no NULL check (g_object_set on NULL → gst bb00d at 20).
BR2_PACKAGE_WEBKITGTK_MULTIMEDIA=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WEBRTC=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OPUS=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEORATE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOTESTSRC=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOTESTSRC=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTP=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTPMANAGER=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_INTERLEAVE=y
BR2_PACKAGE_LIBSOUP3=y
BR2_PACKAGE_SQLITE=y

# Tauri Desktop Client (Fedora RPM) links libasound — without alsa-lib the binary fails at load.
BR2_PACKAGE_ALSA_LIB=y
# Install chime needs aplay (ALSA_UTILS alone does not enable the APLAY suboption).
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# Disk installer apply: ESP + partitioning helpers
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
# WebKit needs real TTF (fontconfig + X11 encodings alone → blank/abort web process).
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_MONO=y
BR2_PACKAGE_DEJAVU_SANS=y
# WebKitGTK sandbox helpers (sandbox itself selects these too; keep explicit).
BR2_PACKAGE_BUBBLEWRAP=y
BR2_PACKAGE_XDG_DBUS_PROXY=y

# AppImage fallback + ops break-glass
BR2_PACKAGE_FUSE3=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_SUDO=y

# GPU firmware — Intel (i915) + AMD (amdgpu) metal laptops
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y

# EliteEW Trusted Substrate — factory work root (EXAMPLE)
# Copy to work-root.env (gitignored) on the build host.
# Large toolchain/Buildroot trees must NOT live under the monorepo.

# Absolute path — separate directory (same or other filesystem).
ELITEEW_TS_WORK_ROOT=/data/repos/eliteew-ts-factory-work

# Optional overrides (default: under WORK_ROOT):
# ELITEEW_TS_TOOLCHAIN_CACHE=${ELITEEW_TS_WORK_ROOT}/toolchain-cache
# ELITEEW_TS_TOOLCHAIN_PREFIX=${ELITEEW_TS_WORK_ROOT}/toolchain-prefix
# ELITEEW_TS_TOOLCHAIN_BUILD=${ELITEEW_TS_WORK_ROOT}/toolchain-build
# ELITEEW_TS_BUILDROOT_CACHE=${ELITEEW_TS_WORK_ROOT}/buildroot-cache
# ELITEEW_TS_BUILDROOT_SRC=${ELITEEW_TS_WORK_ROOT}/buildroot-src
# ELITEEW_TS_BUILDROOT_OUT=${ELITEEW_TS_WORK_ROOT}/buildroot-output

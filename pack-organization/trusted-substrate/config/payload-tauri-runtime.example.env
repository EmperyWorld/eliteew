# Purpose: pin Fedora x86_64 tray RPMs for Buildroot post-build bake (Tauri libappindicator-sys).
# Copy to payload-tauri-runtime.env (gitignored) on the factory host.
#
# Populate dir (example on command-center):
#   mkdir -p ~/eliteew-ts-factory-work/tauri-runtime-rpms
#   cd ~/eliteew-ts-factory-work/tauri-runtime-rpms
#   dnf download --setopt=gpgcheck=0 \
#     libayatana-appindicator-gtk3 libayatana-indicator-gtk3 libayatana-ido-gtk3 \
#     libdbusmenu libdbusmenu-gtk3 libappindicator-gtk3
#   keep only *.x86_64.rpm ; sha256sum *.rpm > SHA256SUMS
#
# Required stems (exactly one *-STEM-*.x86_64.rpm each):
#   libayatana-appindicator-gtk3
#   libayatana-indicator-gtk3
#   libayatana-ido-gtk3
#   libdbusmenu
#   libdbusmenu-gtk3
#   libappindicator-gtk3

ELITEEW_TS_TRAY_RPM_DIR=/data/repos/eliteew-ts-factory-work/tauri-runtime-rpms

#!/usr/bin/env bash
# Purpose: Start unlocked org.freedesktop.secrets on the current session bus.
# Must run inside dbus-run-session (same bus as EliteEW Desktop Client).
# Related: device_keys / device_request_prepare (Rust keyring sync-secret-service)
set -euo pipefail

log() { printf 'eliteew-ts-secrets-up: %s\n' "$*" >&2; }

if ! command -v gnome-keyring-daemon >/dev/null 2>&1; then
  log "WARN: gnome-keyring-daemon missing — device_request_prepare will fail closed"
  exit 0
fi

mkdir -p "${HOME}/.local/share/keyrings"
chmod 700 "${HOME}/.local/share/keyrings" 2>/dev/null || true

# Only export KEY=value lines (daemon also prints discover_other_daemon noise).
apply_daemon_env() {
  local out="$1"
  eval "$(printf '%s\n' "${out}" | grep -E '^[A-Z_][A-Z0-9_]*=')" || true
  export GNOME_KEYRING_CONTROL="${GNOME_KEYRING_CONTROL:-}"
  export SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}"
}

secrets_reachable() {
  timeout 2 dbus-send --session \
    --dest=org.freedesktop.secrets \
    --print-reply \
    /org/freedesktop/secrets \
    org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1
}

secrets_writable() {
  timeout 3 bash -c \
    'printf "%s" ok | secret-tool store --label=eliteew-ts-secrets-up service eliteew.ts.secrets-up account probe' \
    >/dev/null 2>&1
}

# PAM-equivalent: password on stdin until NUL, then daemonize + --start.
# --login alone sets GNOME_KEYRING_CONTROL but does not claim
# org.freedesktop.secrets; without --start, secret-tool sees no login collection.
# Prefer this over unlock alone (unlock often returns a Prompt without pinentry).
login_with() {
  local pass="$1"
  local out
  out="$(printf '%s\0' "${pass}" | gnome-keyring-daemon --daemonize --login --components=secrets 2>/dev/null || true)"
  apply_daemon_env "${out}"
  out="$(gnome-keyring-daemon --start --components=secrets 2>/dev/null || true)"
  apply_daemon_env "${out}"
}

# Fresh create: empty master (appliance keyring; autologin never feeds PAM password).
if [[ ! -f "${HOME}/.local/share/keyrings/login.keyring" ]]; then
  log "creating login keyring (empty master)"
  login_with ''
fi

# If a prior activation left a locked daemon on this bus, replace it via --login.
if secrets_reachable && ! secrets_writable; then
  log "replacing locked Secret Service on session bus"
  killall gnome-keyring-daemon >/dev/null 2>&1 || true
  sleep 0.3
fi

# Unlock/start for this session bus.
login_with ''
if secrets_reachable && secrets_writable; then
  log "Secret Service unlocked (empty master)"
  exit 0
fi

# Factory break-glass default (kickstart chpasswd) — live boxes that created
# login.keyring while unlocking with that password.
killall gnome-keyring-daemon >/dev/null 2>&1 || true
sleep 0.3
login_with 'eliteew-ts-change-me'
if secrets_reachable && secrets_writable; then
  log "Secret Service unlocked (factory unlock candidate)"
  exit 0
fi

# Last resort: plain --start (may leave collection locked).
out="$(gnome-keyring-daemon --start --components=secrets 2>/dev/null || true)"
apply_daemon_env "${out}"
if secrets_reachable && secrets_writable; then
  log "Secret Service writable after --start"
  exit 0
fi

if secrets_reachable; then
  log "WARN: Secret Service on bus but login collection not writable — prepare may fail"
else
  log "WARN: org.freedesktop.secrets not on session bus"
fi
exit 0

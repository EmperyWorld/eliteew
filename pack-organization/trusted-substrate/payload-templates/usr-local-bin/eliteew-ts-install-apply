# Official baked SoT may still clamp DPoP iat to local+15. Installer time
# is minute precision, so that clamp misses Keycloak [now-25, now+15] and
# PAR returns 400. Live share/bin must be IdP-Date before wipe. After
# extract: keep dest when it already uses IdP Date (mux SoT). Only plant
# from live share/bin when the extracted ELF fails that check.
runtime_uses_idp_date() {
  local p="$1"
  readable_regular "$p" || return 1
  grep -a -q 'oidc dpop iat missing Date' "$p" || return 1
  grep -a -q 'operator_wall_clock' "$p" || return 1
  grep -a -q 'portal_hostmap_required' "$p" || return 1
  grep -a -q 'wall_clock_required' "$p" || return 1
  grep -a -q 'date_header_missing' "$p" && return 1
  return 0
}

pick_idp_date_runtime() {
  local p
  for p in \
    /usr/local/share/eliteew-ts-installer/empiieros-runtime \
    /usr/local/bin/empiieros-runtime
  do
    if runtime_uses_idp_date "$p"; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  return 1
}

require_idp_date_runtime() {
  pick_idp_date_runtime >/dev/null \
    || die "live runtime lacks IdP Date DPoP; refuse wipe"
}

plant_idp_date_runtime() {
  local src dest
  dest="$MNT/usr/local/bin/empiieros-runtime"
  if runtime_uses_idp_date "$dest"; then
    log "extracted Runtime already IdP Date DPoP; keep SoT"
    return 0
  fi
  src="$(pick_idp_date_runtime)" \
    || die "live runtime lacks IdP Date DPoP"
  install -m 0755 "$src" "$dest" || die "failed to plant IdP Date runtime"
  if [[ "$(id -u)" -eq 0 ]]; then
    chown 0:0 "$dest" || die "failed to chown IdP Date runtime"
  fi
  runtime_uses_idp_date "$dest" || die "planted runtime lacks IdP Date DPoP"
  log "planted IdP Date DPoP runtime"
}


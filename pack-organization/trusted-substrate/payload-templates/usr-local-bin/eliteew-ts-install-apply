cmd_wifi_scan() {
  require_live_media
  local iface=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --iface) iface="$2"; shift 2 ;;
      *) die "unknown wifi-scan arg: $1" ;;
    esac
  done
  [[ -n "$iface" ]] || die "wifi-scan requires --iface"
  allow_iface "$iface"
  [[ -d "/sys/class/net/${iface}/wireless" || -d "/sys/class/net/${iface}/phy80211" ]] \
    || die "$iface is not a Wi-Fi interface"
  command -v iw >/dev/null 2>&1 || die "iw unavailable"
  rfkill unblock wifi >/dev/null 2>&1 || true
  iw dev "$iface" scan
}

cmd_network_wifi() {
  require_live_media
  local iface="" ssid="" country="00" allow_open=0 psk="" escaped_ssid escaped_psk
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --iface) iface="$2"; shift 2 ;;
      --ssid) ssid="$2"; shift 2 ;;
      --country) country="$2"; shift 2 ;;
      --allow-open) allow_open=1; shift ;;
      *) die "unknown network-wifi arg: $1" ;;
    esac
  done
  [[ -n "$iface" && -n "$ssid" ]] || die "network-wifi requires --iface and --ssid"
  allow_iface "$iface"
  [[ -d "/sys/class/net/${iface}/wireless" || -d "/sys/class/net/${iface}/phy80211" ]] \
    || die "$iface is not a Wi-Fi interface"
  [[ ${#ssid} -ge 1 && ${#ssid} -le 32 && "$ssid" != *$'\n'* && "$ssid" != *$'\r'* ]] \
    || die "SSID must be 1..32 bytes without control newlines"
  valid_wifi_country "$country" || die "country must be 00 or two uppercase letters"
  IFS= read -r psk || psk=""
  if [[ -n "$psk" ]]; then
    valid_wifi_psk "$psk" \
      || die "Wi-Fi passphrase must be 8..63 printable ASCII characters"
  elif [[ "$allow_open" -ne 1 ]]; then
    die "Wi-Fi passphrase is required unless open network was explicitly selected"
  fi

  mkdir -p "$NETWORK_DIR" "$WPA_DIR" "$INSTALL_STATE_DIR"
  chmod 0700 "$WPA_DIR" "$INSTALL_STATE_DIR"
  clear_installer_network_configs
  clear_installer_wifi_config
  cat >"${NETWORK_DIR}/20-eliteew-ts-install-${iface}.network" <<EOF
[Match]
Name=${iface}

[Network]
DHCP=ipv4
IPv6AcceptRA=no

[Link]
RequiredForOnline=no
EOF
  escaped_ssid="$(escape_wpa_string "$ssid")"
  escaped_psk="$(escape_wpa_string "$psk")"
  # Same recipe as Runtime wifi_control: this image's wpa_supplicant
  # rejects `ctrl_interface=` and `SAE`. Mixed WPA2/WPA3 APs still
  # accept WPA-PSK. Never log the PSK.
  command -v rfkill >/dev/null 2>&1 && rfkill unblock wifi >/dev/null 2>&1 || true
  {
    printf 'update_config=0\ncountry=%s\n\n' "$country"
    printf 'network={\n    ssid="%s"\n    scan_ssid=1\n' "$escaped_ssid"
    if [[ -n "$psk" ]]; then
      printf '    psk="%s"\n    key_mgmt=WPA-PSK\n' "$escaped_psk"
    else
      printf '    key_mgmt=NONE\n'
    fi
    printf '}\n'
  } >"${WPA_DIR}/wpa_supplicant-${iface}.conf"
  chmod 0600 "${WPA_DIR}/wpa_supplicant-${iface}.conf"
  [[ -s "${WPA_DIR}/wpa_supplicant-${iface}.conf" ]] \
    || die "Wi-Fi profile write produced an empty file"
  grep -Fq "ssid=\"${escaped_ssid}\"" "${WPA_DIR}/wpa_supplicant-${iface}.conf" \
    || die "Wi-Fi profile missing requested SSID"
  printf '%s\n' "$iface" >"$WIFI_INTERFACE_FILE"
  chmod 0600 "$WIFI_INTERFACE_FILE"

  networkctl reload || die "networkctl reload failed"
  log "network-wifi: associating iface=${iface} ssid=${ssid}"
  start_installer_wifi_unit "$iface"
  networkctl reconfigure "$iface" || die "networkctl reconfigure failed for $iface"
  local attempt associated=0
  for ((attempt = 0; attempt < 40; attempt++)); do
    if iw dev "$iface" link 2>/dev/null \
      | awk -v expected="$ssid" '
          /^[[:space:]]*SSID:[[:space:]]/ {
            sub(/^[[:space:]]*SSID:[[:space:]]*/, "")
            if ($0 == expected) found = 1
          }
          END { exit !found }
        '; then
      associated=1
      break
    fi
    sleep 0.5
  done
  if [[ "$associated" -ne 1 ]]; then
    local link
    link="$(iw dev "$iface" link 2>/dev/null | tr '\n' ' ' | head -c 180)"
    die "SSID '${ssid}' on ${iface} was not observed (${link:-not connected})"
  fi
  ip -4 addr flush dev "$iface" scope global >/dev/null 2>&1 || true
  networkctl reconfigure "$iface" >/dev/null 2>&1 || true
  wait_for_ipv4 "$iface" || die "Wi-Fi associated but no IPv4 lease was observed"
  log "network-wifi: ${iface} ssid=${ssid}"
}

cmd_regional() {
  require_live_media
  local locale="" timezone="" wall_clock=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --locale) locale="$2"; shift 2 ;;
      --timezone) timezone="$2"; shift 2 ;;
      --datetime) wall_clock="$2"; shift 2 ;;
      *) die "unknown regional arg: $1" ;;
    esac
  done
  valid_locale "$locale" || die "unsupported locale: $locale"
  valid_timezone "$timezone" || die "unsupported timezone: $timezone"
  valid_wall_clock "$wall_clock" || die "datetime must be YYYY-MM-DD HH:MM"
  mkdir -p "$INSTALL_STATE_DIR"
  chmod 0700 "$INSTALL_STATE_DIR"
  {
    printf 'locale=%s\n' "$locale"
    printf 'timezone=%s\n' "$timezone"
    printf 'datetime=%s\n' "$wall_clock"
  } >"$REGIONAL_FILE"
  chmod 0600 "$REGIONAL_FILE"
  systemctl stop systemd-timesyncd.service >/dev/null 2>&1 || true
  timedatectl set-ntp false >/dev/null 2>&1 || true
  if command -v timedatectl >/dev/null 2>&1; then
    timedatectl set-timezone "$timezone" >/dev/null 2>&1 \
      || ln -sfn "/usr/share/zoneinfo/${timezone}" /etc/localtime
  else
    ln -sfn "/usr/share/zoneinfo/${timezone}" /etc/localtime
    printf '%s\n' "$timezone" >/etc/timezone
  fi
  TZ="$timezone" date -s "$wall_clock" >/dev/null \
    || die "failed to set live wall clock"
  if command -v hwclock >/dev/null 2>&1; then
    if hwclock --systohc --utc >/dev/null 2>&1; then
      log "regional: hwclock systohc utc ok"
    else
      log "regional: hwclock systohc failed; first-boot stamp remains SoT"
    fi
  else
    log "regional: hwclock missing; first-boot stamp remains SoT"
  fi
  log "regional: locale=${locale} timezone=${timezone} datetime=${wall_clock}"
}

cmd_reboot() {
  require_live_media
  # Teardown contract (after GUI stopped labwc): sync → umount leftovers → reboot.
  log "reboot: sync"
  sync
  log "reboot: umount installer mounts"
  release_installer_mounts
  umount -R /mnt/eliteew-ts-install 2>/dev/null || true
  umount -R /mnt/eliteew-ts-repair 2>/dev/null || true
  sync
  log "reboot: systemctl reboot"
  systemctl reboot || reboot -f
}

# --- disk-install (minimal contract) ---

cmd_disk_install() {
  require_live_media
  local disk="" expected_identity="" observed_identity="" commit=0 p1 p2 p3 grubbin partuuid root_uuid
  local recovery="" luks_uuid="" tpm="no"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --disk) disk="$2"; shift 2 ;;
      --expected-identity) expected_identity="$2"; shift 2 ;;
      --commit) commit=1; shift ;;
      --dry-run) commit=0; shift ;;
      *) die "unknown arg: $1" ;;
    esac
  done
  [[ -n "$disk" ]] || die "--disk required"
  [[ -n "$expected_identity" ]] || die "--expected-identity required"
  allow_disk "$disk"
  observed_identity="$(disk_identity "$disk" || true)"
  [[ "$observed_identity" == "$expected_identity" ]] \
    || die "disk identity changed after selection; refusing wipe"
  local disk_sectors
  disk_sectors="$(cat "/sys/class/block/${disk##*/}/size")"
  [[ "$disk_sectors" =~ ^[0-9]+$ && "$disk_sectors" -ge 16777216 ]] \
    || die "target disk is smaller than 8 GiB"
  [[ "$commit" -eq 1 ]] && release_installer_mounts
  refuse_live_or_mounted_disk "$disk"
  verify_install_proof

  if [[ "$commit" -ne 1 ]]; then
    log "dry-run: would wipe $disk and extract $ROOTFS_ARCHIVE"
    echo "dry-run: would install onto $disk"
    exit 0
  fi

  require_disk_tools
  verify_rootfs_archive
  verify_install_proof
  require_install_clock_sources
  require_idp_date_runtime
  require_portal_up
  require_seat_shell
  require_seat_time_helper
  require_state_unlock_agent

  # 1–2. wipe + GPT (ESP + root + state) — wipe must succeed (no silent continue)
  log "wipe + partition $disk"
  if command -v wipefs >/dev/null 2>&1; then
    wipefs -a "$disk" || die "wipefs failed on $disk"
  else
    dd if=/dev/zero of="$disk" bs=1M count=4 status=none conv=fsync \
      || die "dd wipe header failed on $disk"
  fi
  write_gpt_esp_root_state "$disk"
  partprobe "$disk" || die "kernel partition-table reread failed on $disk"
  udevadm settle --timeout=10 || die "partition devices did not settle"
  p1="$(disk_part "$disk" 1)"
  p2="$(disk_part "$disk" 2)"
  p3="$(disk_part "$disk" 3)"
  [[ -b "$p1" && -b "$p2" && -b "$p3" ]] || die "partitions missing after sfdisk"

  # 3. mkfs ESP/root only. LUKS waits until the extracted target has cryptsetup.
  log "mkfs $p1 $p2"
  mkfs.vfat -F32 -n ELITEEWESP "$p1" || die "EFI filesystem creation failed"
  mkfs.ext4 -F -L eliteew-root "$p2" || die "root filesystem creation failed"

  # 4. mount + extract reference archive (BusyBox tar: no -z)
  mkdir -p "$MNT"
  trap 'release_installer_mounts' EXIT
  mount "$p2" "$MNT" || die "root filesystem mount failed"
  mkdir -p "$MNT/boot/efi"
  mount "$p1" "$MNT/boot/efi" || die "EFI filesystem mount failed"
  log "extract $ROOTFS_ARCHIVE"
  # Heartbeats on stdout while gzip|tar is silent — GUI progress + log stay alive.
  (
    while true; do
      sleep 3
      log "extract … still running" || true
    done
  ) &
  _extract_hb=$!
  if ! gzip -dc "$ROOTFS_ARCHIVE" | tar -C "$MNT" -x; then
    kill "${_extract_hb}" 2>/dev/null || true
    wait "${_extract_hb}" 2>/dev/null || true
    die "rootfs extract failed"
  fi
  kill "${_extract_hb}" 2>/dev/null || true
  wait "${_extract_hb}" 2>/dev/null || true
  log "extract complete"
  [[ -f "$MNT/boot/bzImage" ]] || die "extract incomplete: missing boot/bzImage"
  [[ -e "$MNT/sbin/init" || -e "$MNT/usr/lib/systemd/systemd" || -e "$MNT/lib/systemd/systemd" ]] \
    || die "extract incomplete: no init/systemd"
  # Archive must not carry live-only stamps (session-router).
  rm -f "$MNT/etc/sudoers.d/eliteew-ts-installer"
  rm -f "$MNT/etc/eliteew-trusted-substrate/live-installer"
  mkdir -p "$MNT/etc/eliteew-trusted-substrate"
  # Live GUI installer stays on USB root; strip from installed metal (C4).
  rm -f "$MNT/usr/local/bin/eliteew-ts-installer"
  rm -f "$MNT/usr/local/bin/eliteew-ts-installer-session"
  rm -rf "$MNT/usr/local/share/eliteew-ts-installer"
  # Defense: kiosk must never own multi-user (agetty + bash_profile path).
  rm -f "$MNT/etc/systemd/system/multi-user.target.wants/eliteew-ts-kiosk.service"

  if [[ ! -x "$MNT/usr/sbin/cryptsetup" && ! -x "$MNT/sbin/cryptsetup" ]]; then
    die "target rootfs has no cryptsetup; refuse to lock state (need BR2_PACKAGE_CRYPTSETUP bake)"
  fi
  recovery="$(resolve_state_recovery)" || die "state recovery resolve failed"
  format_state_luks "$p3" "$recovery"
  open_state_luks "$p3" "$recovery"
  mkfs.ext4 -F -L eliteew-state "/dev/mapper/${STATE_MAPPER}" \
    || die "state filesystem creation failed"
  if enroll_state_tpm "$p3" "$recovery"; then
    tpm=yes
  fi
  luks_uuid="$(cryptsetup luksUUID "$p3" | tr -d '[:space:]')"
  [[ "$luks_uuid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
    || die "state LUKS UUID is malformed"
  mkdir -p "$MNT/var/lib/empiieros-runtime"
  mount "/dev/mapper/${STATE_MAPPER}" "$MNT/var/lib/empiieros-runtime" \
    || die "state volume mount failed"
  chmod 0700 "$MNT/var/lib/empiieros-runtime"
  write_target_state_unlock "$MNT" "$luks_uuid" "$tpm"
  issue_state_recovery_reveal "$recovery"
  rm -f -- "${INSTALL_STATE_DIR}/state-recovery-input"
  recovery=""

  # Propagate installer network configuration to installed OS.
  # DHCP stays on image 20-wired.network — a 10- override freezes the
  # install-time address and blocks cable DHCP after first boot.
  mkdir -p "$MNT/etc/systemd/network"
  local netcfg copied_net=0
  rm -f "$MNT"/etc/systemd/network/10-eliteew-ts-install-*.network
  if [[ ! -f "$STATIC_OK_FILE" ]]; then
    log "no operator-static this session; skip 10- persist"
  else
  for netcfg in "$NETWORK_DIR"/20-eliteew-ts-install-*.network; do
    if [[ -f "$netcfg" ]]; then
      local bname
      bname="$(basename "$netcfg")"
      if installer_profile_is_dhcp "$netcfg"; then
        log "DHCP installer profile $bname: skip 10- persist; target keeps 20-wired.network"
        continue
      fi
      refuse_polygon_lab_address "$(cat "$netcfg")"
      log "copying network configuration $bname to target OS as 10-${bname#20-}"
      persist_installer_network_profile "$netcfg" "$MNT/etc/systemd/network/10-${bname#20-}"
      copied_net=1
    fi
  done
  fi
  if [[ "$copied_net" -eq 1 ]]; then
    local copied_count
    copied_count="$(find "$MNT/etc/systemd/network" -maxdepth 1 -type f -name '10-eliteew-ts-install-*.network' | wc -l)"
    [[ "$copied_count" -eq 1 ]] || die "expected exactly one persisted installer network config, got $copied_count"
    log "installer network configuration successfully persisted to target"
  else
    log "no installer network configuration found; keeping default network configuration"
  fi

  plant_installed_wifi_unit
  plant_install_clock
  plant_idp_date_runtime
  plant_ota_cutover_rw
  plant_portal_up
  plant_ota_fetch
  plant_seat_shell
  plant_seat_time_helper
  plant_target_console_policy
  plant_target_state_unlock_agent

  # Persist an installer-created Wi-Fi profile without exposing its passphrase
  # in argv or the installer log. The boot restore service validates 0600/root.
  if [[ -f "$WIFI_INTERFACE_FILE" ]]; then
    local wifi_iface wifi_source wifi_target
    wifi_iface="$(cat "$WIFI_INTERFACE_FILE")"
    allow_iface "$wifi_iface"
    wifi_source="${WPA_DIR}/wpa_supplicant-${wifi_iface}.conf"
    [[ -f "$wifi_source" && ! -L "$wifi_source" ]] \
      || die "staged Wi-Fi profile is missing or unsafe"
    mkdir -p "$MNT/etc/wpa_supplicant"
    chmod 0700 "$MNT/etc/wpa_supplicant"
    wifi_target="$MNT/etc/wpa_supplicant/wpa_supplicant-${wifi_iface}.conf"
    install -m 0600 -o 0 -g 0 "$wifi_source" "$wifi_target"
    log "installer Wi-Fi profile persisted for ${wifi_iface}"
  fi

  # Regional settings are selected before installation and applied to the
  # installed system, not merely to the live session.
  local install_locale="ru_RU.UTF-8" install_timezone="Europe/Moscow"
  local install_datetime=""
  if [[ -f "$REGIONAL_FILE" && ! -L "$REGIONAL_FILE" ]]; then
    install_locale="$(awk -F= '$1=="locale" {print substr($0,8); exit}' "$REGIONAL_FILE")"
    install_timezone="$(awk -F= '$1=="timezone" {print substr($0,10); exit}' "$REGIONAL_FILE")"
    install_datetime="$(awk -F= '$1=="datetime" {print substr($0,10); exit}' "$REGIONAL_FILE")"
  fi
  valid_locale "$install_locale" || die "invalid staged locale"
  valid_timezone "$install_timezone" || die "invalid staged timezone"
  [[ -n "$install_datetime" ]] || die "staged wall clock missing"
  valid_wall_clock "$install_datetime" || die "invalid staged wall clock"
  # Live clock was set at Regional and has been ticking. Stamp that
  # current minute, not the original form value from an hour ago.
  live_now="$(TZ="$install_timezone" date +%Y-%m-%d\ %H:%M)" || true
  if valid_wall_clock "$live_now"; then
    install_datetime="$live_now"
  fi
  printf 'LANG=%s\n' "$install_locale" >"$MNT/etc/locale.conf"
  printf '%s\n' "$install_timezone" >"$MNT/etc/timezone"
  ln -sfn "/usr/share/zoneinfo/${install_timezone}" "$MNT/etc/localtime"
  mkdir -p "$MNT/etc/empiieros"
  printf '%s\n' "$install_datetime" >"$MNT/etc/empiieros/install-wall-clock"
  chmod 0644 "$MNT/etc/empiieros/install-wall-clock"
  log "target wall clock stamp=${install_datetime} timezone=${install_timezone}"
  if [[ "$install_locale" == ru_* ]]; then
    printf 'ru\n' >"$MNT/etc/empiieros/ui-locale"
  else
    printf 'en\n' >"$MNT/etc/empiieros/ui-locale"
  fi
  chmod 0644 \
    "$MNT/etc/locale.conf" \
    "$MNT/etc/timezone" \
    "$MNT/etc/empiieros/ui-locale"
  log "regional settings persisted: locale=${install_locale} timezone=${install_timezone}"
  mkdir -p "$MNT/etc/systemd/timesyncd.conf.d"
  cat >"$MNT/etc/systemd/timesyncd.conf.d/00-no-public-ntp.conf" <<'EOF'
[Time]
NTP=
FallbackNTP=
EOF
  chmod 0644 "$MNT/etc/systemd/timesyncd.conf.d/00-no-public-ntp.conf"
  rm -f "$MNT/etc/systemd/system/sysinit.target.wants/systemd-timesyncd.service"
  ln -sfn /dev/null "$MNT/etc/systemd/system/systemd-timesyncd.service"
  log "target timesyncd masked; public NTP empty"

  issue_target_first_boot_pin "$MNT"
  issue_target_device_keys "$MNT"

  # 5. unique SSH host keys on target (never bake into rootfs.tar.gz)
  generate_target_ssh_host_keys
  provision_target_operator_key

  # 6. bootloader (live grub-install → target ESP; archive has no grub-install)
  partuuid="$(read_uuid_field "$p2" PARTUUID)"
  root_uuid="$(read_uuid_field "$p2" UUID)"
  grubbin="$(grub_install_bin)"
  log "grub-install $disk"
  mkdir -p "$MNT/boot/efi" "$MNT/boot/grub"
  "$grubbin" --target=x86_64-efi \
    --efi-directory="$MNT/boot/efi" \
    --boot-directory="$MNT/boot" \
    --bootloader-id=EliteEW \
    --recheck \
    --removable \
    "$disk" || die "grub-install failed"
  write_grub_cfg "$MNT" "$partuuid" "$root_uuid"
  if [[ -f "$MNT/boot/efi/EFI/EliteEW/grubx64.efi" ]]; then
    cp -a "$MNT/boot/efi/EFI/EliteEW/grubx64.efi" "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
  elif [[ -f "$MNT/boot/efi/EFI/BOOT/grubx64.efi" && ! -f "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" ]]; then
    cp -a "$MNT/boot/efi/EFI/BOOT/grubx64.efi" "$MNT/boot/efi/EFI/BOOT/BOOTX64.EFI" 2>/dev/null || true
  fi

  verify_target_install_contract "$MNT" "$install_locale" "$install_timezone"
  touch "$MNT$COMPLETE_FLAG"

  # 7. sync + umount
  sync
  trap - EXIT
  release_installer_mounts
  log "disk-install complete"
  echo "install complete on $disk"
}

# Print the live-session PIN to stdout only. Never log the digits.
cmd_pin_reveal() {
  local reveal="${INSTALL_STATE_DIR}/first-boot-pin"
  local pin
  [[ -f "$reveal" && ! -L "$reveal" ]] || die "first-boot PIN reveal missing"
  pin="$(tr -d '\r\n' <"$reveal")"
  [[ "$pin" =~ ^[0-9]{4}$ ]] || die "first-boot PIN reveal is malformed"
  printf '%s\n' "$pin"
}

# Print the live-session state recovery to stdout only. Never log it.
cmd_recovery_reveal() {
  local reveal="${INSTALL_STATE_DIR}/state-recovery"
  local recovery
  [[ -f "$reveal" && ! -L "$reveal" ]] || die "state recovery reveal missing"
  recovery="$(tr -d '\r\n' <"$reveal")"
  valid_state_unlock_secret "$recovery" || die "state recovery reveal is malformed"
  printf '%s\n' "$recovery"
}

main() {
  [[ $# -ge 1 ]] || die "usage: eliteew-ts-install-apply <regional|live-network-forget|network-dhcp|network-static|wifi-scan|network-wifi|disk-install|state-recovery-stage|pin-reveal|recovery-reveal|reboot> …"
  local cmd="$1"
  shift
  case "$cmd" in
    regional) cmd_regional "$@" ;;
    live-network-forget) cmd_live_network_forget "$@" ;;
    network-dhcp) cmd_network_dhcp "$@" ;;
    network-static) cmd_network_static "$@" ;;
    wifi-scan) cmd_wifi_scan "$@" ;;
    network-wifi) cmd_network_wifi "$@" ;;
    disk-install) cmd_disk_install "$@" ;;
    state-recovery-stage) cmd_state_recovery_stage "$@" ;;
    pin-reveal) cmd_pin_reveal "$@" ;;
    recovery-reveal) cmd_recovery_reveal "$@" ;;
    reboot) cmd_reboot "$@" ;;
    *) die "unknown command: $cmd" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi

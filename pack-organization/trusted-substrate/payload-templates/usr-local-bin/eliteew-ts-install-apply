# Live-media install apply (root). Product SoT = Buildroot rootfs.tar.gz only.
# disk-install: safety → wipe/GPT (ESP+root+state) → LUKS2 state → extract → PIN + device keys → grub.
set -euo pipefail

LOG="${ELITEEW_TS_INSTALL_LOG:-/var/log/eliteew-ts-install.log}"
ROOTFS_ARCHIVE="${ELITEEW_TS_ROOTFS_ARCHIVE:-/opt/eliteew-ts-install/rootfs.tar.gz}"
ROOTFS_HASH="${ELITEEW_TS_ROOTFS_HASH:-${ROOTFS_ARCHIVE}.sha256}"
COMPLETE_FLAG="${ELITEEW_TS_INSTALL_COMPLETE:-/etc/eliteew-trusted-substrate/INSTALL-COMPLETE}"
LIVE_FLAG="${ELITEEW_TS_LIVE_FLAG:-/etc/eliteew-trusted-substrate/live-installer}"
FLOCK_PATH="${ELITEEW_TS_INSTALL_LOCK:-/run/eliteew-ts-install.lock}"
MNT="${ELITEEW_TS_INSTALL_MNT:-/mnt/eliteew-ts-install}"
NETWORK_DIR="${ELITEEW_TS_NETWORK_DIR:-/etc/systemd/network}"
WPA_DIR="${ELITEEW_TS_WPA_DIR:-/etc/wpa_supplicant}"
INSTALL_STATE_DIR="${ELITEEW_TS_INSTALL_STATE_DIR:-/run/eliteew-ts-installer}"
REGIONAL_FILE="${INSTALL_STATE_DIR}/regional"
WIFI_INTERFACE_FILE="${INSTALL_STATE_DIR}/wifi-interface"
STATIC_OK_FILE="${INSTALL_STATE_DIR}/network-static-ok"
WIFI_UNIT="${ELITEEW_TS_WIFI_UNIT:-/etc/systemd/system/empiieros-wifi@.service}"

mkdir -p "$(dirname "$LOG")" /run 2>/dev/null || true
exec 9>"$FLOCK_PATH"
if ! flock -n 9; then
  echo "another install apply is running" >&2
  exit 75
fi

log() {
  # stderr + file only. stdout is pin-reveal / recovery-reveal /
  # recovery="$(resolve_state_recovery)" — a log line on stdout would
  # become the LUKS passphrase.
  printf 'unix=%s [APPLY] %s\n' "$(date -u +%s)" "$*" | tee -a "$LOG" >&2
}

die() {
  log "ERROR: $*"
  exit 1
}

require_live_media() {
  [[ -e "$LIVE_FLAG" ]] || die "refused: requires live-installer stamp ($LIVE_FLAG)"
}

allow_disk() {
  local d="$1"
  if [[ "${ELITEEW_TS_ALLOW_LOOP:-}" == 1 && "$d" =~ ^/dev/loop[0-9]+$ ]]; then
    [[ -b "$d" ]] || die "not a block device: $d"
    return 0
  fi
  [[ "$d" =~ ^/dev/(sd[a-z]+|vd[a-z]+|hd[a-z]+|nvme[0-9]+n[0-9]+)$ ]] || die "disk not allowlisted: $d"
  [[ -b "$d" ]] || die "not a block device: $d"
}

disk_part() {
  local disk="$1" n="$2"
  case "$disk" in
    *nvme*|*mmcblk*|*loop*) printf '%sp%s\n' "$disk" "$n" ;;
    *) printf '%s%s\n' "$disk" "$n" ;;
  esac
}

disk_identity() {
  local disk="$1" name="${1##*/}" dev sectors serial="none"
  [[ -d "/sys/class/block/${name}" ]] || return 1
  dev="$(cat "/sys/class/block/${name}/dev")"
  sectors="$(cat "/sys/class/block/${name}/size")"
  if [[ -f "/sys/class/block/${name}/device/serial" ]]; then
    serial="$(cat "/sys/class/block/${name}/device/serial")"
    serial="${serial#"${serial%%[![:space:]]*}"}"
    serial="${serial%"${serial##*[![:space:]]}"}"
    [[ -n "$serial" ]] || serial="none"
  fi
  printf '%s|%s|%s\n' "$dev" "$sectors" "$serial"
}

verify_rootfs_archive() {
  local expected observed
  [[ -f "$ROOTFS_ARCHIVE" && ! -L "$ROOTFS_ARCHIVE" ]] \
    || die "rootfs archive missing or unsafe: $ROOTFS_ARCHIVE"
  [[ -f "$ROOTFS_HASH" && ! -L "$ROOTFS_HASH" ]] \
    || die "rootfs archive hash missing: $ROOTFS_HASH"
  expected="$(awk 'NR==1 {print $1}' "$ROOTFS_HASH")"
  [[ "$expected" =~ ^[0-9a-f]{64}$ ]] || die "rootfs archive hash is malformed"
  observed="$(sha256sum "$ROOTFS_ARCHIVE" | awk '{print $1}')"
  [[ "$observed" == "$expected" ]] || die "rootfs archive hash mismatch"
  log "rootfs archive verified sha256=${observed}"
}

proof_path_allowed() {
  local path="$1"
  [[ "$path" != *..* ]] || return 1
  case "$path" in
    /opt/eliteew-ts-install/*|/mnt/e2e-payload/*) return 0 ;;
    *) return 1 ;;
  esac
}

read_dmi_uuid() {
  local path value
  for path in \
    /sys/class/dmi/id/product_uuid \
    /sys/class/dmi/id/board_serial \
    /sys/class/dmi/id/product_serial; do
    [[ -f "$path" ]] || continue
    value="$(tr -d '\r\n' <"$path" 2>/dev/null || true)"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    [[ -n "$value" ]] || continue
    case "${value,,}" in
      none|unknown|"to be filled by o.e.m.") continue ;;
    esac
    printf '%s\n' "$value"
    return 0
  done
  printf '%s\n' "no-hw-uuid"
}

fingerprint_v2() {
  local hostname="$1" machine_id="$2" hardware_uuid="$3" digest
  digest="$(printf '%s' "eliteew-desktop-client|v2|${hostname}|${machine_id}|${hardware_uuid}" \
    | sha256sum | awk '{print $1}')"
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf 'fp_v2_%s\n' "$(printf '%s' "$digest" | cut -c1-32)"
}

# SoT ships an empty /etc/machine-id. systemd-machine-id-setup fills it on
# first boot. The PIN hash must use that committed id, not "no-machine-id".
commit_target_machine_id() {
  local target="$1"
  local path="${target}/etc/machine-id"
  local dbus="${target}/var/lib/dbus/machine-id"
  local current id
  current="$(tr -d '\r\n' <"$path" 2>/dev/null || true)"
  current="${current#"${current%%[![:space:]]*}"}"
  current="${current%"${current##*[![:space:]]}"}"
  if [[ "$current" =~ ^[0-9a-f]{32}$ ]]; then
    printf '%s\n' "$current"
    return 0
  fi
  id="$(dd if=/dev/urandom bs=16 count=1 status=none | od -An -tx1 | tr -d ' \n')"
  [[ "$id" =~ ^[0-9a-f]{32}$ ]] || return 1
  mkdir -p "${target}/etc" "${target}/var/lib/dbus"
  printf '%s\n' "$id" >"$path"
  chmod 0444 "$path"
  printf '%s\n' "$id" >"$dbus"
  chmod 0444 "$dbus"
  printf '%s\n' "$id"
}

hash_first_boot_pin() {
  local salt_hex="$1" fingerprint="$2" pin="$3"
  printf '%s' "empiieros-first-boot-pin-v1|${salt_hex}|${fingerprint}|${pin}" \
    | sha256sum | awk '{print $1}'
}

is_trivial_pin() {
  case "$1" in
    0000|1111|2222|3333|4444|5555|6666|7777|8888|9999|1234|4321) return 0 ;;
    *) return 1 ;;
  esac
}

generate_first_boot_pin() {
  local raw n digits attempt
  for ((attempt = 0; attempt < 32; attempt++)); do
    raw="$(od -An -tu2 -N2 /dev/urandom | tr -d '[:space:]')"
    [[ "$raw" =~ ^[0-9]+$ ]] || continue
    n=$((10#$raw))
    if (( n >= 65536 - (65536 % 10000) )); then
      continue
    fi
    digits=$((n % 10000))
    printf -v digits '%04d' "$digits"
    if is_trivial_pin "$digits"; then
      continue
    fi
    printf '%s\n' "$digits"
    return 0
  done
  return 1
}

# 128-bit recovery for LUKS2. Never the 4-digit PIN. Never logged.
generate_state_recovery() {
  local raw grouped
  raw="$(dd if=/dev/urandom bs=16 count=1 status=none | od -An -tx1 | tr -d ' \n')"
  [[ "$raw" =~ ^[0-9a-f]{32}$ ]] || return 1
  grouped="$(printf '%s' "$raw" | sed 's/..../&-/g; s/-$//')"
  [[ "$grouped" =~ ^[0-9a-f]{4}(-[0-9a-f]{4}){7}$ ]] || return 1
  printf '%s\n' "$grouped"
}

valid_state_recovery() {
  [[ "$1" =~ ^[0-9a-f]{4}(-[0-9a-f]{4}){7}$ ]]
}

# Operator-chosen LUKS secret. Never a 4-digit PIN. Never logged.
valid_state_user_secret() {
  local secret="$1"
  local n="${#secret}"
  (( n >= 12 && n <= 128 )) || return 1
  [[ "$secret" != *$'\n'* && "$secret" != *$'\r'* ]] || return 1
  [[ "$secret" =~ [[:cntrl:]] ]] && return 1
  [[ "$secret" =~ ^[0-9]{1,8}$ ]] && return 1
  is_trivial_pin "$secret" && return 1
  return 0
}

valid_state_unlock_secret() {
  valid_state_recovery "$1" || valid_state_user_secret "$1"
}

# WPA passphrase is 8–63 ASCII octets. Live installer LANG is ru_RU.UTF-8;
# bash bracket ranges follow collation there and reject "12345678".
valid_wifi_psk() {
  local psk="$1"
  (
    export LC_ALL=C LANG=C
    [[ ${#psk} -ge 8 && ${#psk} -le 63 && "$psk" =~ ^[\ -~]+$ ]]
  )
}

valid_wifi_country() {
  local country="$1"
  [[ "$country" == "00" ]] && return 0
  (
    export LC_ALL=C LANG=C
    [[ "$country" =~ ^[A-Z]{2}$ ]]
  )
}

prepare_install_state_dir() {
  mkdir -p "$INSTALL_STATE_DIR"
  chmod 0750 "$INSTALL_STATE_DIR"
  chgrp eliteew-ts "$INSTALL_STATE_DIR" 2>/dev/null || true
}

# stdin: first line auto|user; user mode then one secret line. Not argv.
cmd_state_recovery_stage() {
  require_live_media
  local mode secret
  IFS= read -r mode || die "state recovery mode missing"
  prepare_install_state_dir
  case "$mode" in
    auto)
      printf 'auto\n' >"${INSTALL_STATE_DIR}/state-recovery-mode"
      chmod 0644 "${INSTALL_STATE_DIR}/state-recovery-mode"
      rm -f -- "${INSTALL_STATE_DIR}/state-recovery-input"
      log "state recovery staged mode=auto"
      ;;
    user)
      IFS= read -r secret || die "user state recovery missing"
      secret="${secret#"${secret%%[![:space:]]*}"}"
      secret="${secret%"${secret##*[![:space:]]}"}"
      valid_state_user_secret "$secret" || die "user state recovery is malformed"
      printf 'user\n' >"${INSTALL_STATE_DIR}/state-recovery-mode"
      chmod 0644 "${INSTALL_STATE_DIR}/state-recovery-mode"
      printf '%s\n' "$secret" >"${INSTALL_STATE_DIR}/state-recovery-input"
      chmod 0600 "${INSTALL_STATE_DIR}/state-recovery-input"
      secret=""
      log "state recovery staged mode=user"
      ;;
    *)
      die "state recovery mode is not auto|user"
      ;;
  esac
}

resolve_state_recovery() {
  local mode="auto" secret=""
  local mode_file="${INSTALL_STATE_DIR}/state-recovery-mode"
  local input_file="${INSTALL_STATE_DIR}/state-recovery-input"
  if [[ -f "$mode_file" && ! -L "$mode_file" ]]; then
    mode="$(tr -d '\r\n' <"$mode_file")"
  fi
  case "$mode" in
    auto)
      secret="$(generate_state_recovery)" || return 1
      log "state recovery mode=auto"
      ;;
    user)
      [[ -f "$input_file" && ! -L "$input_file" ]] || die "user state recovery is missing"
      secret="$(tr -d '\r\n' <"$input_file")"
      secret="${secret#"${secret%%[![:space:]]*}"}"
      secret="${secret%"${secret##*[![:space:]]}"}"
      valid_state_user_secret "$secret" || die "user state recovery is malformed"
      log "state recovery mode=user"
      ;;
    *)
      die "state recovery mode is not auto|user"
      ;;
  esac
  printf '%s\n' "$secret"
}

# FoFline V2 wipe ticket: product family only. Living Capsule v3 is
# consume after first-boot unlock — never install media.
INSTALL_PROOF_BODY='{"v":1,"kind":"empiieros-install-proof-v1","product_id":"eliteew-fofline"}'

verify_install_proof() {
  local proof="${ELITEEW_TS_INSTALL_PROOF:-/opt/eliteew-ts-install/install-proof.json}"
  local body
  proof_path_allowed "$proof" || die "install proof path is not allowlisted: $proof"
  [[ -f "$proof" && ! -L "$proof" ]] || die "install proof missing or unsafe: $proof"
  [[ "$(stat -c '%s' "$proof")" -le 128 ]] || die "install proof is too large"
  body="$(tr -d '\r\n' <"$proof")"
  [[ "$body" == "$INSTALL_PROOF_BODY" ]] || die "install proof is malformed"
  log "install proof verified product=eliteew-fofline"
}

issue_target_first_boot_pin() {
  local target="$1"
  local hostname machine_id hardware_uuid fingerprint salt_hex pin pin_hash epoch
  local seat stamp reveal
  hostname="$(tr -d '\r\n' <"${target}/etc/hostname" 2>/dev/null || true)"
  hostname="${hostname#"${hostname%%[![:space:]]*}"}"
  hostname="${hostname%"${hostname##*[![:space:]]}"}"
  [[ -n "$hostname" ]] || hostname="unknown-host"
  machine_id="$(commit_target_machine_id "$target")" \
    || die "target machine-id commit failed"
  [[ "$machine_id" =~ ^[0-9a-f]{32}$ ]] || die "target machine-id is malformed"
  hardware_uuid="$(read_dmi_uuid)"
  fingerprint="$(fingerprint_v2 "$hostname" "$machine_id" "$hardware_uuid")" \
    || die "hardware fingerprint failed"
  [[ "$fingerprint" =~ ^fp_v2_[0-9a-f]{32}$ ]] || die "hardware fingerprint is malformed"
  salt_hex="$(dd if=/dev/urandom bs=16 count=1 status=none | od -An -tx1 | tr -d '[:space:]')"
  [[ "$salt_hex" =~ ^[0-9a-f]{32}$ ]] || die "pin salt failed"
  pin="$(generate_first_boot_pin)" || die "pin rng failed"
  pin_hash="$(hash_first_boot_pin "$salt_hex" "$fingerprint" "$pin")"
  [[ "$pin_hash" =~ ^[0-9a-f]{64}$ ]] || die "pin hash failed"
  epoch="$(date -u +%s)"
  seat="${target}/var/lib/empiieros-runtime/seat"
  mkdir -p "${target}/var/lib/empiieros-runtime" "$seat" "${target}/etc/empiieros"
  chmod 0700 "${target}/var/lib/empiieros-runtime" "$seat"
  printf '%s\n' \
    "{\"v\":1,\"fingerprint\":\"${fingerprint}\",\"salt_hex\":\"${salt_hex}\",\"pin_hash\":\"${pin_hash}\",\"issued_epoch\":${epoch},\"unlocked\":false,\"unlocked_epoch\":0,\"failed_attempts\":0,\"locked_until_epoch\":0}" \
    >"${seat}/first_boot_pin.json"
  printf 'issued\n' >"${seat}/first_boot_pin.issued"
  chmod 0600 "${seat}/first_boot_pin.json" "${seat}/first_boot_pin.issued"
  if grep -q '"pin":' "${seat}/first_boot_pin.json"; then
    rm -f -- "${seat}/first_boot_pin.json" "${seat}/first_boot_pin.issued"
    die "pin record contained a pin field"
  fi
  stamp="${target}/etc/empiieros/hardware-stamp"
  {
    printf 'v=1\n'
    printf 'scheme=fp_v2\n'
    printf 'fingerprint=%s\n' "$fingerprint"
    printf 'hostname=%s\n' "$hostname"
    printf 'machine_id=%s\n' "$machine_id"
  } >"$stamp"
  chmod 0644 "$stamp"
  mkdir -p "$INSTALL_STATE_DIR"
  chmod 0750 "$INSTALL_STATE_DIR"
  chgrp eliteew-ts "$INSTALL_STATE_DIR" 2>/dev/null || true
  reveal="${INSTALL_STATE_DIR}/first-boot-pin"
  printf '%s\n' "$pin" >"$reveal"
  chmod 0640 "$reveal"
  chgrp eliteew-ts "$reveal" 2>/dev/null || true
  pin=""
  log "first-boot PIN issued fingerprint=${fingerprint}"
  log "hardware stamp persisted"
  log "target first-boot PIN record planted"
}

issue_target_device_keys() {
  # Recipient SK for air/file consume. Production Runtime has device.keys.*
  # compiled out; without this file launcher.air_activate is immediately
  # device_keys_missing. Plant on the opened LUKS volume. Never log the SK.
  # PIN is not this key.
  local target="$1"
  local dir sk path
  dir="${target}/var/lib/empiieros-runtime/device_keys"
  mkdir -p "${target}/var/lib/empiieros-runtime" "$dir"
  chmod 0700 "${target}/var/lib/empiieros-runtime" "$dir"
  sk="$(dd if=/dev/urandom bs=32 count=1 status=none | od -An -tx1 | tr -d '[:space:]')"
  [[ "$sk" =~ ^[0-9a-f]{64}$ ]] || die "device recipient key rng failed"
  path="${dir}/recipient.sk.hex"
  printf '%s\n' "$sk" >"$path"
  chmod 0600 "$path"
  sk=""
  if [[ ! -f "$path" || -L "$path" ]]; then
    rm -f -- "$path"
    die "device recipient key plant failed"
  fi
  [[ "$(stat -c '%a' "$path")" == "600" ]] || die "device recipient key mode is not 0600"
  [[ "$(tr -d '\r\n' <"$path")" =~ ^[0-9a-f]{64}$ ]] || die "device recipient key is malformed"
  log "target device recipient key planted"
}

STATE_MAPPER="empiieros-state"
STATE_MIB=2048

issue_state_recovery_reveal() {
  local recovery="$1"
  local reveal
  valid_state_unlock_secret "$recovery" || die "state recovery is malformed"
  mkdir -p "$INSTALL_STATE_DIR"
  chmod 0750 "$INSTALL_STATE_DIR"
  chgrp eliteew-ts "$INSTALL_STATE_DIR" 2>/dev/null || true
  reveal="${INSTALL_STATE_DIR}/state-recovery"
  printf '%s\n' "$recovery" >"$reveal"
  chmod 0640 "$reveal"
  chgrp eliteew-ts "$reveal" 2>/dev/null || true
  log "state recovery issued (plaintext not logged)"
}

format_state_luks() {
  local part="$1" recovery="$2"
  valid_state_unlock_secret "$recovery" || die "state recovery is malformed"
  command -v cryptsetup >/dev/null 2>&1 || die "cryptsetup missing; cannot create state LUKS"
  printf '%s' "$recovery" | cryptsetup luksFormat \
    --type luks2 \
    --batch-mode \
    --key-file=- \
    --pbkdf argon2id \
    "$part" || die "luksFormat failed on state slot"
  cryptsetup isLuks "$part" || die "state slot is not LUKS after format"
  log "state luks formatted"
}

open_state_luks() {
  local part="$1" recovery="$2"
  printf '%s' "$recovery" | cryptsetup luksOpen \
    --key-file=- \
    "$part" "$STATE_MAPPER" || die "luksOpen failed on state slot"
  [[ -b "/dev/mapper/${STATE_MAPPER}" ]] || die "state mapper missing after luksOpen"
}

close_state_luks() {
  umount "/dev/mapper/${STATE_MAPPER}" 2>/dev/null || true
  cryptsetup luksClose "$STATE_MAPPER" 2>/dev/null || true
}

enroll_state_tpm() {
  local part="$1" recovery="$2"
  if [[ ! -c /dev/tpmrm0 && ! -c /dev/tpm0 ]]; then
    log "state tpm=no"
    return 1
  fi
  if ! command -v systemd-cryptenroll >/dev/null 2>&1; then
    log "state tpm=no"
    return 1
  fi
  if printf '%s' "$recovery" | systemd-cryptenroll --unlock-key-file=- --tpm2-device=auto "$part"; then
    log "state tpm=yes"
    return 0
  fi
  log "state tpm=no"
  return 1
}

write_target_state_unlock() {
  local target="$1" luks_uuid="$2" tpm="$3"
  local extra=""
  [[ "$tpm" == yes ]] && extra=",tpm2-device=auto"
  mkdir -p "$target/etc" "$target/etc/systemd/system/empiieros-runtime.service.d"
  printf 'empiieros-state UUID=%s none luks,discard%s\n' "$luks_uuid" "$extra" \
    >"${target}/etc/crypttab"
  chmod 0644 "${target}/etc/crypttab"
  touch "${target}/etc/fstab"
  if ! grep -q '/var/lib/empiieros-runtime' "${target}/etc/fstab"; then
    printf '/dev/mapper/%s /var/lib/empiieros-runtime ext4 defaults 0 2\n' "$STATE_MAPPER" \
      >>"${target}/etc/fstab"
  fi
  cat >"${target}/etc/systemd/system/empiieros-runtime.service.d/state-luks.conf" <<'EOF'
[Unit]
RequiresMountsFor=/var/lib/empiieros-runtime
EOF
  chmod 0644 "${target}/etc/systemd/system/empiieros-runtime.service.d/state-luks.conf"
}

write_gpt_esp_root_state() {
  local disk="$1"
  local disk_sectors start esp_sectors state_sectors p2_start p2_size p3_size min_root
  disk_sectors="$(cat "/sys/class/block/${disk##*/}/size")"
  [[ "$disk_sectors" =~ ^[0-9]+$ ]] || die "cannot read disk size for $disk"
  start=2048
  esp_sectors=$((512 * 2048))
  state_sectors=$((STATE_MIB * 2048))
  p2_start=$((start + esp_sectors))
  p3_size=$state_sectors
  p2_size=$((disk_sectors - p2_start - p3_size - 2048))
  min_root=$((4 * 1024 * 2048))
  [[ "$p2_size" -ge "$min_root" ]] || die "root would be smaller than 4 GiB after state slot"
  sfdisk --wipe always "$disk" <<EOF || die "partition table creation failed on $disk"
label: gpt
unit: sectors
${start},${esp_sectors},U
${p2_start},${p2_size},L
,${p3_size},L
EOF
}

allow_iface() {
  local iface="$1"
  [[ "$iface" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]] || die "iface not allowlisted: $iface"
  [[ -e "/sys/class/net/${iface}" ]] || die "iface missing: $iface"
}

valid_ipv4() {
  local raw="$1" a b c d extra
  IFS=. read -r a b c d extra <<<"$raw"
  [[ -z "${extra:-}" && -n "${a:-}" && -n "${b:-}" && -n "${c:-}" && -n "${d:-}" ]] || return 1
  local octet
  for octet in "$a" "$b" "$c" "$d"; do
    [[ "$octet" =~ ^[0-9]{1,3}$ ]] || return 1
    ((10#$octet >= 0 && 10#$octet <= 255)) || return 1
  done
}

valid_ipv4_cidr() {
  local raw="$1" address prefix extra
  IFS=/ read -r address prefix extra <<<"$raw"
  [[ -z "${extra:-}" && "${prefix:-}" =~ ^[0-9]{1,2}$ ]] || return 1
  ((10#$prefix >= 1 && 10#$prefix <= 32)) || return 1
  valid_ipv4 "$address"
}

select_installer_iface() {
  local path iface fallback=""
  for path in /sys/class/net/*; do
    [[ -e "$path" ]] || continue
    iface="${path##*/}"
    [[ "$iface" == "lo" ]] && continue
    [[ -n "$fallback" ]] || fallback="$iface"
    if [[ "$(cat "$path/carrier" 2>/dev/null || true)" == "1" ]]; then
      printf '%s\n' "$iface"
      return 0
    fi
  done
  [[ -n "$fallback" ]] || return 1
  printf '%s\n' "$fallback"
}

clear_installer_network_configs() {
  local path
  for path in "$NETWORK_DIR"/20-eliteew-ts-install-*.network \
              "$NETWORK_DIR"/10-eliteew-ts-install-*.network; do
    [[ -f "$path" ]] && rm -f -- "$path"
  done
  # A non-matching literal glob leaves the final [[ -f ... ]] false. Under
  # `set -e`, returning that status aborts network setup before a config exists.
  return 0
}

clear_installer_wifi_config() {
  local conf iface
  for conf in "$WPA_DIR"/wpa_supplicant-*.conf; do
    [[ -f "$conf" ]] || continue
    iface="${conf##*/wpa_supplicant-}"
    iface="${iface%.conf}"
    if [[ "$iface" =~ ^[a-zA-Z][a-zA-Z0-9_.-]{0,14}$ ]]; then
      systemctl reset-failed "empiieros-wifi@${iface}.service" >/dev/null 2>&1 || true
      systemctl stop "empiieros-wifi@${iface}.service" >/dev/null 2>&1 || true
    fi
    rm -f -- "$conf"
  done
  rm -f -- "$WIFI_INTERFACE_FILE" "$STATIC_OK_FILE"
  return 0
}

# Live USB keeps leftover wpa/network from a previous glass or install
# click. That is not a baked SoT profile — delete it. Never print a PSK.
forget_live_network_state() {
  require_live_media
  clear_installer_wifi_config
  clear_installer_network_configs
  networkctl reload >/dev/null 2>&1 || true
  log "live-network-forget: leftover installer wifi/network profiles removed"
}

cmd_live_network_forget() {
  forget_live_network_state
}

wifi_unit_detail() {
  local unit="$1"
  {
    systemctl show "$unit" -p Result -p ActiveState -p SubState -p NRestarts --no-pager 2>/dev/null || true
    journalctl -u "$unit" -n 16 --no-pager -o cat 2>/dev/null || true
  } | tr '\n' ' ' | head -c 280
}

# Previous SAE/ctrl_interface attempts crash-loop the unit
# (StartLimitBurst=3). A new operator click must reset that, not inherit it.
# Type=simple makes `restart` return 0 as soon as exec happens — nl80211
# can still die immediately. Wait and require a live MainPID.
start_installer_wifi_unit() {
  local iface="$1"
  local unit="empiieros-wifi@${iface}.service"
  local detail="" pid=""
  [[ -s "${WPA_DIR}/wpa_supplicant-${iface}.conf" ]] \
    || die "Wi-Fi profile empty for $iface"
  ip link set "$iface" up >/dev/null 2>&1 || true
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  if ! systemctl restart "$unit"; then
    detail="$(wifi_unit_detail "$unit")"
    die "wpa_supplicant service failed for $iface${detail:+: $detail}"
  fi
  sleep 0.6
  pid="$(systemctl show "$unit" -p MainPID --value --no-pager 2>/dev/null || true)"
  if ! systemctl is-active --quiet "$unit" || [[ -z "$pid" || "$pid" == 0 ]]; then
    detail="$(wifi_unit_detail "$unit")"
    die "wpa_supplicant died after start for $iface${detail:+: $detail}"
  fi
}

# Live installer profiles stay RequiredForOnline=no so the USB session does not
# block on network-online.target. The installed copy must require IPv4 online.
rewrite_persisted_network_online_requirement() {
  awk '
    BEGIN { changed = 0 }
    $0 == "RequiredForOnline=no" {
      print "RequiredForOnline=yes"
      changed = 1
      next
    }
    { print }
    END { if (changed == 0) exit 2 }
  ' "$1"
}

installer_profile_is_dhcp() {
  local src="$1"
  grep -qx 'DHCP=no' "$src" && return 1
  grep -Eqx 'DHCP=(yes|ipv4)' "$src"
}

# Lab polygon /30 must never become a product address.
refuse_polygon_lab_address() {
  local blob="$1"
  if printf '%s\n' "$blob" | grep -Eq '192\.168\.8\.(9|10)(/|[[:space:]]|$)'; then
    die "refusing polygon lab address 192.168.8.10/192.168.8.9"
  fi
}

persist_installer_network_profile() {
  local src="$1"
  local dest="$2"
  local tmp
  [[ -f "$src" && ! -L "$src" ]] || die "installer network profile missing: $src"
  [[ "$dest" == *.network ]] || die "persisted network destination is unsafe"
  refuse_polygon_lab_address "$(cat "$src")"
  tmp="${dest}.tmp"
  rewrite_persisted_network_online_requirement "$src" >"$tmp" \
    || die "persisted network profile must rewrite RequiredForOnline=yes"
  grep -qx 'RequiredForOnline=yes' "$tmp" \
    || die "persisted network profile lacks RequiredForOnline=yes"
  if grep -qx 'RequiredForOnline=no' "$tmp"; then
    rm -f -- "$tmp"
    die "persisted network profile still has RequiredForOnline=no"
  fi
  install -m 0644 -o 0 -g 0 "$tmp" "$dest"
  rm -f -- "$tmp"
}

valid_locale() {
  [[ "$1" == "ru_RU.UTF-8" || "$1" == "en_US.UTF-8" ]]
}

valid_timezone() {
  local timezone="$1"
  [[ "$timezone" =~ ^[A-Za-z][A-Za-z0-9_+-]*/[A-Za-z0-9_+./-]+$ ]] || return 1
  [[ "$timezone" != *".."* ]] || return 1
  [[ -f "/usr/share/zoneinfo/${timezone}" ]]
}

valid_wall_clock() {
  local value="$1" year month day hour minute
  [[ "$value" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})\ ([0-9]{2}):([0-9]{2})$ ]] || return 1
  year="${BASH_REMATCH[1]}"
  month="${BASH_REMATCH[2]#0}"
  day="${BASH_REMATCH[3]#0}"
  hour="${BASH_REMATCH[4]#0}"
  minute="${BASH_REMATCH[5]#0}"
  [[ "$year" -ge 2024 && "$year" -le 2100 ]] || return 1
  [[ "$month" -ge 1 && "$month" -le 12 ]] || return 1
  [[ "$day" -ge 1 && "$day" -le 31 ]] || return 1
  [[ "$hour" -le 23 ]] || return 1
  [[ "$minute" -le 59 ]] || return 1
}

wait_for_ipv4() {
  local iface="$1" attempt
  for ((attempt = 0; attempt < 30; attempt++)); do
    if ip -4 -o address show dev "$iface" scope global 2>/dev/null \
      | awk '$0 ~ / inet / { found = 1 } END { exit !found }'; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

escape_wpa_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

verify_target_install_contract() {
  local target="$1" expected_locale="$2" expected_timezone="$3" path metadata field
  awk -F: '$1=="eliteew-ts" && $3=="105" && $4=="113" { found = 1 }
    END { exit !found }' "$target/etc/passwd" \
    || die "target kiosk identity is not uid:gid 105:113"
  awk -F: '$1=="empiieros-maint" && $3=="106" && $4=="114" { found = 1 }
    END { exit !found }' "$target/etc/passwd" \
    || die "target maintenance identity is not uid:gid 106:114"
  for path in \
    usr/local/bin/empiieros-runtime \
    usr/local/bin/empiieros-shell-gui \
    etc/systemd/system/empiieros-runtime.service \
    etc/systemd/system/empiieros-shell-bridge.socket \
    etc/systemd/system/empiieros-shell-bridge.service \
    etc/locale.conf \
    etc/timezone \
    etc/empiieros/ui-locale; do
    [[ -e "$target/$path" && ! -L "$target/$path" ]] \
      || die "target contract missing or symlinked: /$path"
  done
  for path in usr/local/bin/empiieros-runtime usr/local/bin/empiieros-shell-gui; do
    metadata="$(stat -c '%u:%g:%a:%F' "$target/$path")"
    [[ "$metadata" == "0:0:755:regular file" ]] \
      || die "target executable owner/mode invalid: /$path ($metadata)"
  done
  verify_seat_shell_trusted "$target/opt/empiieros/shell" \
    || die "seat shell is not root-owned"
  field="$(awk -F: '$1=="eliteew-ts"{print $2; exit}' "$target/etc/shadow")"
  [[ -n "$field" ]] || die "target eliteew-ts shadow missing"
  case "$field" in
    '!'*|'*'*) ;;
    *) die "target eliteew-ts must stay password-locked (no extra VT login)" ;;
  esac
  local _tty
  for _tty in 2 3 4 5 6; do
    [[ -L "$target/etc/systemd/system/getty@${_tty}.service" ]] \
      && [[ "$(readlink -f "$target/etc/systemd/system/getty@${_tty}.service")" == "/dev/null" ]] \
      || die "target getty@${_tty} must be masked to /dev/null"
    [[ ! -e "$target/etc/systemd/system/getty.target.wants/getty@${_tty}.service" ]] \
      || die "target getty@${_tty} must not be enabled in getty.target.wants"
  done
  [[ ! -e "$target/etc/eliteew-trusted-substrate/live-installer" ]] \
    || die "target still has live-installer stamp"
  [[ ! -e "$target/etc/sudoers.d/eliteew-ts-installer" ]] \
    || die "target still has installer sudo policy"
  [[ -f "$target/var/lib/empiieros-runtime/seat/first_boot_pin.json" && \
     ! -L "$target/var/lib/empiieros-runtime/seat/first_boot_pin.json" ]] \
    || die "target first-boot PIN record missing"
  [[ "$(stat -c '%a' "$target/var/lib/empiieros-runtime/seat/first_boot_pin.json")" == "600" ]] \
    || die "target first-boot PIN record mode is not 0600"
  grep -q '"pin":' "$target/var/lib/empiieros-runtime/seat/first_boot_pin.json" \
    && die "target first-boot PIN record contains plaintext"
  grep -q '"pin_hash"' "$target/var/lib/empiieros-runtime/seat/first_boot_pin.json" \
    || die "target first-boot PIN record lacks pin_hash"
  [[ -f "$target/var/lib/empiieros-runtime/device_keys/recipient.sk.hex" && \
     ! -L "$target/var/lib/empiieros-runtime/device_keys/recipient.sk.hex" ]] \
    || die "target device recipient key missing"
  [[ "$(stat -c '%a' "$target/var/lib/empiieros-runtime/device_keys")" == "700" ]] \
    || die "target device_keys dir mode is not 0700"
  [[ "$(stat -c '%a' "$target/var/lib/empiieros-runtime/device_keys/recipient.sk.hex")" == "600" ]] \
    || die "target device recipient key mode is not 0600"
  [[ "$(tr -d '\r\n' <"$target/var/lib/empiieros-runtime/device_keys/recipient.sk.hex")" =~ ^[0-9a-f]{64}$ ]] \
    || die "target device recipient key is malformed"
  [[ -f "$target/etc/empiieros/hardware-stamp" && ! -L "$target/etc/empiieros/hardware-stamp" ]] \
    || die "target hardware stamp missing"
  grep -qx 'scheme=fp_v2' "$target/etc/empiieros/hardware-stamp" \
    || die "target hardware stamp scheme is not fp_v2"
  [[ "$(cat "$target/etc/locale.conf")" == "LANG=${expected_locale}" ]] \
    || die "target locale does not match installer selection"
  [[ "$(cat "$target/etc/timezone")" == "$expected_timezone" ]] \
    || die "target timezone does not match installer selection"
  [[ -f "$target/etc/empiieros/install-wall-clock" && \
     ! -L "$target/etc/empiieros/install-wall-clock" ]] \
    || die "target install wall clock stamp missing"
  [[ "$(tr -d '\r\n' <"$target/etc/empiieros/install-wall-clock")" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] \
    || die "target install wall clock stamp is malformed"
  [[ -f "$target/usr/local/sbin/empiieros-apply-install-clock" && \
     ! -L "$target/usr/local/sbin/empiieros-apply-install-clock" ]] \
    || die "target install-clock helper missing"
  [[ -f "$target/etc/systemd/system/empiieros-apply-install-clock.service" && \
     ! -L "$target/etc/systemd/system/empiieros-apply-install-clock.service" ]] \
    || die "target install-clock unit missing"
  [[ -L "$target/etc/systemd/system/multi-user.target.wants/empiieros-apply-install-clock.service" ]] \
    || die "target install-clock unit not enabled"
  [[ -f "$target/etc/crypttab" && ! -L "$target/etc/crypttab" ]] \
    || die "target crypttab missing"
  grep -q '^empiieros-state UUID=' "$target/etc/crypttab" \
    || die "target crypttab lacks state LUKS line"
  if grep -Eiq '(^|[^0-9a-f-])[0-9]{4}([^0-9a-f-]|$)' "$target/etc/crypttab"; then
    die "target crypttab looks like it contains a PIN"
  fi
  grep -q '/var/lib/empiieros-runtime' "$target/etc/fstab" \
    || die "target fstab lacks state mount"
  [[ -f "$target/etc/systemd/system/empiieros-wifi@.service" && \
     ! -L "$target/etc/systemd/system/empiieros-wifi@.service" ]] \
    || die "target wifi unit missing"
  wifi_unit_has_inet "$target/etc/systemd/system/empiieros-wifi@.service" \
    || die "target wifi unit lacks AF_INET"
  [[ -f "$target/etc/systemd/system/empiieros-runtime.service.d/state-luks.conf" ]] \
    || die "target Runtime state-luks drop-in missing"
  [[ ! -e "$target/run/eliteew-ts-installer/state-recovery" ]] \
    || die "state recovery leaked onto target"
  [[ ! -e "$target/var/lib/empiieros-runtime/state-recovery" ]] \
    || die "state recovery leaked into state volume"
  [[ -f "$target/usr/local/bin/empiieros-state-unlock-agent" && \
     ! -L "$target/usr/local/bin/empiieros-state-unlock-agent" ]] \
    || die "target state unlock agent missing"
  [[ "$(stat -c '%u:%g:%a:%F' "$target/usr/local/bin/empiieros-state-unlock-agent")" == "0:0:755:regular file" ]] \
    || die "target state unlock agent owner/mode invalid"
  for path in \
    etc/systemd/system/empiieros-state-unlock-agent.path \
    etc/systemd/system/empiieros-state-unlock-agent.service; do
    [[ -f "$target/$path" && ! -L "$target/$path" ]] \
      || die "target state unlock unit missing or symlinked: /$path"
  done
  [[ "$(target_path_under_root "$target" etc/systemd/system/cryptsetup.target.wants/empiieros-state-unlock-agent.path 2>/dev/null || true)" \
        == "$(readlink -f "$target/etc/systemd/system/empiieros-state-unlock-agent.path")" ]] \
    || die "target state unlock path not enabled for cryptsetup.target"
  [[ "$(target_symlink_raw "$target" etc/systemd/system/systemd-ask-password-console.path || true)" == "/dev/null" ]] \
    || die "target systemd-ask-password-console.path must be masked to /dev/null"
  [[ "$(target_symlink_raw "$target" etc/systemd/system/systemd-ask-password-wall.path || true)" == "/dev/null" ]] \
    || die "target systemd-ask-password-wall.path must be masked to /dev/null"
  log "target install contract verified"
}

target_symlink_raw() {
  local target="$1" path="$2"
  [[ -L "$target/$path" ]] || return 1
  readlink "$target/$path"
}

target_path_under_root() {
  # Resolve a symlink recorded on the installed root without following host /etc.
  local target="$1" link_path="$2"
  local raw base resolved
  raw="$(target_symlink_raw "$target" "$link_path")" || return 1
  case "$raw" in
    /*) printf '%s%s\n' "$target" "$raw" ;;
    *)
      base="$(dirname "$link_path")"
      resolved="$(cd "$target/$base" && cd "$(dirname "$raw")" && pwd)/$(basename "$raw")"
      printf '%s\n' "$resolved"
      ;;
  esac
}

wifi_unit_has_inet() {
  # AF_INET6 must not count as AF_INET.
  grep -Eq '(^|[[:space:]])AF_INET([[:space:]]|$)' "$1"
}

plant_installed_wifi_unit() {
  # Official SoT still ships RestrictAddressFamilies without AF_INET.
  # This image's wpa nl80211 opens PF_INET; systemd then returns
  # EAFNOSUPPORT, the AP never sees a probe, and DHCP has no carrier.
  # Live USB already has the working unit; plant that after extract.
  local dest="$MNT/etc/systemd/system/empiieros-wifi@.service"
  [[ -f "$WIFI_UNIT" && ! -L "$WIFI_UNIT" ]] \
    || die "live wifi unit missing or unsafe"
  wifi_unit_has_inet "$WIFI_UNIT" \
    || die "live wifi unit lacks AF_INET; refusing to plant a silent nl80211 unit"
  mkdir -p "$MNT/etc/systemd/system"
  install -m 0644 "$WIFI_UNIT" "$dest" || die "failed to plant wifi unit"
  if [[ "$(id -u)" -eq 0 ]]; then
    chown 0:0 "$dest" || die "failed to chown planted wifi unit"
  fi
  [[ -f "$dest" && ! -L "$dest" ]] || die "planted wifi unit missing"
  wifi_unit_has_inet "$dest" || die "planted wifi unit lacks AF_INET"
  log "planted live wifi unit with AF_INET onto target"
}

readable_regular() {

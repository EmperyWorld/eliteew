# empiieros-shell-gui serves empiier://shell/ only for root-owned regular
# files with no group/other write. cp -a keeps the USB owner's uid, and
# that uid is not 0, so the seat draws "Shell asset is not trusted".
verify_seat_shell_trusted() {
  local dest="$1" path metadata saw=0
  [[ -d "$dest" && ! -L "$dest" ]] || return 1
  if find "$dest" -type l -print -quit | grep -q .; then
    return 1
  fi
  while IFS= read -r -d '' path; do
    saw=1
    metadata="$(stat -c '%u:%a:%F' "$path")"
    case "$metadata" in
      0:644:regular\ file|0:755:directory) ;;
      *) return 1 ;;
    esac
  done < <(find "$dest" \( -type f -o -type d \) -print0)
  [[ "$saw" -eq 1 ]]
}

plant_seat_shell() {
  local src dest
  src="$(seat_shell_src)"
  seat_shell_ok || die "live seat shell lacks clock set and portal step"
  dest="$MNT/opt/empiieros/shell"
  [[ -d "$dest" && ! -L "$dest" ]] || die "target shell dir missing"
  [[ "$(id -u)" -eq 0 ]] || die "seat shell plant requires root"
  rm -rf "$dest/assets"
  cp -a "$src/." "$dest/" || die "failed to plant seat shell"
  chown -R 0:0 "$dest" || die "failed to chown seat shell"
  find "$dest" -type d -exec chmod 0755 {} + \
    || die "failed to chmod seat shell dirs"
  find "$dest" -type f -exec chmod 0644 {} + \
    || die "failed to chmod seat shell files"
  verify_seat_shell_trusted "$dest" || die "seat shell is not root-owned"
  grep -q 'Поставить часы' "$dest"/assets/*.js \
    || die "planted seat shell missing clock control"
  log "planted seat shell root-owned"
}

# Product console is tty1 only (autologin → session-router). Extra VT gettys stay masked.
plant_target_console_policy() {
  local _tty
  mkdir -p "$MNT/etc/systemd/system"
  for _tty in 2 3 4 5 6; do
    ln -sfn /dev/null "$MNT/etc/systemd/system/getty@${_tty}.service"
    rm -f "$MNT/etc/systemd/system/getty.target.wants/getty@${_tty}.service"
  done
  log "target console policy: tty1 only; tty2–6 masked"
}


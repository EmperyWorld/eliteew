# Fresh BR extract has no device nodes — chroot ssh-keygen MUST see host /dev+/proc.
ensure_chroot_dev_proc() {
  mkdir -p "$MNT/dev" "$MNT/proc"
  if ! mountpoint -q "$MNT/dev"; then
    mount --bind /dev "$MNT/dev" || die "mount --bind /dev → $MNT/dev failed"
  fi
  [[ -c "$MNT/dev/null" ]] || die "no /dev/null after mount --bind /dev"
  if ! mountpoint -q "$MNT/proc"; then
    mount --bind /proc "$MNT/proc" || die "mount --bind /proc → $MNT/proc failed"
  fi
}

release_chroot_dev_proc() {
  umount -l "$MNT/dev" 2>/dev/null || true
  umount -l "$MNT/proc" 2>/dev/null || true
}

generate_target_ssh_host_keys() {
  log "ssh-keygen -A (target)"
  rm -f "$MNT"/etc/ssh/ssh_host_*
  mkdir -p "$MNT/etc/ssh"
  # Primary: chroot into extracted root after bind /dev+/proc (unique keys on target tooling).
  if [[ -x "$MNT/usr/bin/ssh-keygen" ]]; then
    log "ssh-keygen path: chroot after mount --bind /dev+/proc"
    ensure_chroot_dev_proc
    if ! chroot "$MNT" /usr/bin/ssh-keygen -A; then
      release_chroot_dev_proc
      die "ssh-keygen -A failed"
    fi
    release_chroot_dev_proc
  elif command -v ssh-keygen >/dev/null 2>&1; then
    log "ssh-keygen path: live -A -f (fallback — target binary missing)"
    ssh-keygen -A -f "$MNT" || die "ssh-keygen -A -f failed"
  else
    die "ssh-keygen missing on target and live"
  fi
  [[ -f "$MNT/etc/ssh/ssh_host_ed25519_key" || -f "$MNT/etc/ssh/ssh_host_rsa_key" ]] \
    || die "no ssh host keys after ssh-keygen -A"
}

provision_target_operator_key() {
  local source=""
  for source in \
    /etc/eliteew-trusted-substrate/operator_authorized_keys \
    /home/eliteew-ts/.ssh/authorized_keys; do
    [[ -s "$source" ]] && break
    source=""
  done

  if [[ -z "$source" ]]; then
    log "operator SSH key not provisioned; sshd remains masked"
    return 0
  fi
  if ! awk '
    /^[[:space:]]*($|#)/ { next }
    $1 ~ /^(ssh-ed25519|sk-ssh-ed25519@openssh[.]com|ecdsa-sha2-nistp(256|384|521)|sk-ecdsa-sha2-nistp256@openssh[.]com|ssh-rsa)$/ &&
      $2 ~ /^[A-Za-z0-9+\/=]+$/ { valid += 1; next }
    { invalid = 1 }
    END { exit !(valid > 0 && invalid == 0) }
  ' "$source"; then
    die "operator authorized_keys has no supported public key"
  fi

  install -d -m 0700 -o 106 -g 114 "$MNT/home/empiieros-maint/.ssh"
  install -m 0600 -o 106 -g 114 \
    "$source" "$MNT/home/empiieros-maint/.ssh/authorized_keys"
  if [[ -L "$MNT/etc/systemd/system/sshd.service" ]] \
    && [[ "$(readlink "$MNT/etc/systemd/system/sshd.service")" == "/dev/null" ]]; then
    rm -f "$MNT/etc/systemd/system/sshd.service"
  fi
  mkdir -p "$MNT/etc/systemd/system/multi-user.target.wants"
  if [[ -f "$MNT/usr/lib/systemd/system/sshd.service" ]]; then
    ln -sfn ../../../../usr/lib/systemd/system/sshd.service \
      "$MNT/etc/systemd/system/multi-user.target.wants/sshd.service"
  elif [[ -f "$MNT/lib/systemd/system/sshd.service" ]]; then
    ln -sfn ../../../../lib/systemd/system/sshd.service \
      "$MNT/etc/systemd/system/multi-user.target.wants/sshd.service"
  else
    die "operator key exists but sshd.service is missing"
  fi
  log "operator SSH public key provisioned; key-only sshd enabled"
}


# util-linux only — BusyBox blkid -s/-o poisons PARTUUID.
read_uuid_field() {
  local dev="$1" field="$2" raw="" link
  if command -v lsblk >/dev/null 2>&1; then
    raw="$(lsblk -n -o "$field" "$dev" 2>/dev/null | head -n1 | tr -d '[:space:]')"
  fi
  if [[ -z "$raw" && "$field" == "PARTUUID" ]]; then
    for link in /dev/disk/by-partuuid/*; do
      [[ -e "$link" ]] || continue
      if [[ "$(readlink -f "$link" 2>/dev/null || true)" == "$(readlink -f "$dev" 2>/dev/null || true)" ]]; then
        raw="${link##*/}"
        break
      fi
    done
  fi
  if [[ -z "$raw" && "$field" == "UUID" ]]; then
    for link in /dev/disk/by-uuid/*; do
      [[ -e "$link" ]] || continue
      if [[ "$(readlink -f "$link" 2>/dev/null || true)" == "$(readlink -f "$dev" 2>/dev/null || true)" ]]; then
        raw="${link##*/}"
        break
      fi
    done
  fi
  [[ "$raw" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] \
    || die "invalid $field for $dev (got: ${raw:-empty})"
  printf '%s\n' "$raw"
}

write_grub_cfg() {
  local mnt="$1" partuuid="$2" root_uuid="$3" cfg
  mkdir -p "$mnt/boot/grub" "$mnt/boot/efi/EFI/BOOT" "$mnt/boot/efi/EFI/EliteEW"
  cfg=$(cat <<EOF
set default=0
set timeout=3
insmod part_gpt
insmod ext2
insmod fat
insmod gzio
insmod all_video
menuentry "EliteEW Trusted Substrate" {
    search --no-floppy --fs-uuid --set=root ${root_uuid}
    linux /boot/bzImage root=PARTUUID=${partuuid} rootwait rw console=tty1
}
EOF
)
  printf '%s\n' "$cfg" >"$mnt/boot/grub/grub.cfg"
  printf '%s\n' "$cfg" >"$mnt/boot/efi/EFI/BOOT/grub.cfg"
  printf '%s\n' "$cfg" >"$mnt/boot/efi/EFI/EliteEW/grub.cfg"
}


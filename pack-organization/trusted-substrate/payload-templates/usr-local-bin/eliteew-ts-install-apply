plant_install_clock() {
  # Official SoT wrote install-wall-clock and never consumed it. First boot
  # must apply that operator stamp when the RTC is implausible. timesyncd
  # stays masked. Prefer the installer share copy — a dirty USB journal
  # has already orphaned a newly planted /usr/local/sbin inode.
  local bin_src unit_src dest_bin dest_unit dest_want
  bin_src="$(pick_install_clock_bin)" \
    || die "live install-clock helper missing or unreadable"
  unit_src="$(pick_install_clock_unit)" \
    || die "live install-clock unit missing or unreadable"
  dest_bin="$MNT/usr/local/sbin/empiieros-apply-install-clock"
  dest_unit="$MNT/etc/systemd/system/empiieros-apply-install-clock.service"
  dest_want="$MNT/etc/systemd/system/multi-user.target.wants/empiieros-apply-install-clock.service"
  mkdir -p "$MNT/usr/local/sbin" "$MNT/etc/systemd/system/multi-user.target.wants"
  install -m 0755 "$bin_src" "$dest_bin" || die "failed to plant install-clock helper"
  install -m 0644 "$unit_src" "$dest_unit" || die "failed to plant install-clock unit"
  ln -sfn /etc/systemd/system/empiieros-apply-install-clock.service "$dest_want"
  if [[ "$(id -u)" -eq 0 ]]; then
    chown 0:0 "$dest_bin" "$dest_unit" || die "failed to chown install-clock plant"
  fi
  [[ -x "$dest_bin" && ! -L "$dest_bin" ]] || die "planted install-clock helper missing"
  [[ -f "$dest_unit" && ! -L "$dest_unit" ]] || die "planted install-clock unit missing"
  [[ -L "$dest_want" ]] || die "planted install-clock unit not enabled"
  log "planted install-clock first-boot apply"
}

refuse_live_or_mounted_disk() {
  local d="$1" root_src="" root_disk="" mounts="" line src
  if command -v findmnt >/dev/null 2>&1; then
    root_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  else
    root_src="$(awk '$2=="/"{print $1; exit}' /proc/mounts 2>/dev/null || true)"
  fi
  if [[ -n "$root_src" ]]; then
    if command -v lsblk >/dev/null 2>&1; then
      root_disk="$(lsblk -no PKNAME "$root_src" 2>/dev/null | head -n1 || true)"
    fi
    if [[ -n "$root_disk" && "/dev/${root_disk}" == "$d" ]]; then
      die "refusing wipe of live/root disk $d"
    fi
    case "$root_src" in
      "$d"|"${d}"p[0-9]*|"${d}"[0-9]*) die "refusing wipe of live/root disk $d" ;;
    esac
    [[ "$root_src" == "$d"* ]] && die "refusing wipe of live/root disk $d (root=$root_src)"
  fi
  if command -v lsblk >/dev/null 2>&1; then
    mounts="$(lsblk -nr -o MOUNTPOINT "$d" 2>/dev/null | awk 'NF' || true)"
  else
    while IFS= read -r line; do
      src="${line%% *}"
      case "$src" in
        "$d"|"${d}"p[0-9]*|"${d}"[0-9]*) mounts="yes" ;;
      esac
    done </proc/mounts
  fi
  [[ -z "$mounts" ]] || die "refusing wipe of mounted disk $d"
}

require_disk_tools() {
  local miss=() c
  for c in sfdisk mkfs.vfat mkfs.ext4 partprobe tar gzip mount umount cryptsetup; do
    command -v "$c" >/dev/null 2>&1 || miss+=("$c")
  done
  command -v grub-install >/dev/null 2>&1 || command -v grub2-install >/dev/null 2>&1 || miss+=("grub-install")
  [[ ${#miss[@]} -eq 0 ]] || die "missing tools: ${miss[*]}"
}


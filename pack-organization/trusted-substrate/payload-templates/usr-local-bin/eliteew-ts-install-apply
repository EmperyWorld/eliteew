cmd_network_static() {
  require_live_media
  local iface="" address="" gateway="" dns=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --iface) iface="$2"; shift 2 ;;
      --address) address="$2"; shift 2 ;;
      --gateway) gateway="$2"; shift 2 ;;
      --dns) dns="$2"; shift 2 ;;
      *) die "unknown arg: $1" ;;
    esac
  done
  [[ -n "$iface" && -n "$address" ]] || die "iface and address required"
  allow_iface "$iface"
  valid_ipv4_cidr "$address" || die "invalid IPv4 CIDR: $address"
  [[ -z "$gateway" ]] || valid_ipv4 "$gateway" || die "invalid IPv4 gateway: $gateway"
  [[ -z "$dns" ]] || valid_ipv4 "$dns" || die "invalid IPv4 DNS server: $dns"
  refuse_polygon_lab_address "$address"
  refuse_polygon_lab_address "$gateway"
  clear_installer_wifi_config
  mkdir -p "$NETWORK_DIR"
  clear_installer_network_configs
  {
    echo "[Match]"
    echo "Name=${iface}"
    echo
    echo "[Network]"
    echo "DHCP=no"
    echo "Address=${address}"
    [[ -n "$gateway" ]] && echo "Gateway=${gateway}"
    [[ -n "$dns" ]] && echo "DNS=${dns}"
    echo "IPv6AcceptRA=no"
    echo
    echo "[Link]"
    echo "RequiredForOnline=no"
  } >"${NETWORK_DIR}/20-eliteew-ts-install-${iface}.network"
  command -v networkctl >/dev/null 2>&1 || die "networkctl unavailable"
  networkctl reload || die "networkctl reload failed"

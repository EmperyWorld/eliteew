# EliteEW · Portal Private Tunnel — command-center metrics scrape oneshot
[Unit]
Description=EliteEW Portal Private Tunnel metrics scrape (SSH → edge loopback exporter)
Documentation=file://%h/powered_by_emperyworld/documentation/platform/docker-re_doc/PORTAL-PRIVATE-TUNNEL-EDGE.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/powered_by_emperyworld
ExecStart=/usr/bin/bash %h/powered_by_emperyworld/docker/scripts/portal-private-tunnel/portalctl metrics
SuccessExitStatus=0 2
Nice=10

# Mobile private tunnel pilot.
# Copy to docker/env_file/.env.mobile-private-tunnel and adjust only when defaults drift.

MOBILE_PRIVATE_TUNNEL_INTERFACE=wg-mobile
MOBILE_PRIVATE_TUNNEL_PORT=51822
MOBILE_PRIVATE_TUNNEL_EDGE_IP=10.88.88.1
MOBILE_PRIVATE_TUNNEL_EDGE_CIDR=10.88.88.1/24
MOBILE_PRIVATE_TUNNEL_DNS_IP=10.88.88.1
MOBILE_PRIVATE_TUNNEL_PEER_NAME=operator-android-1
MOBILE_PRIVATE_TUNNEL_PEER_IP=10.88.88.101

# Comma-separated names that resolve to the edge WG IP for tunnel clients.
MOBILE_PRIVATE_TUNNEL_HOSTNAMES=app.eliteew.ru,auth.eliteew.ru,meet.eliteew.ru

# Comma-separated upstream resolvers used by edge dnsmasq for non-EliteEW lookups.
MOBILE_PRIVATE_TUNNEL_DNS_UPSTREAMS=1.1.1.1,8.8.8.8

# ---
# EliteEW · Empery World · https://empery.world
# Author: po&T && TZBrand
# ---
# Purpose:
# Non-secret placeholder infra env for bake-time OpenAPI schema export from the
# monorepo tree (import api.main → .openapi()). Merged under staging
# docker/env_file/.env.stack0.backend — staging wins on duplicate keys.
# Invariants:
# - No passwords, tokens, or prod URLs; values exist only so DatabaseConfig /
#   UnifiedConfig can import. Not for serving traffic.
# - Used by docker/scripts/stack0-refresh-openapi-pilots.sh only.
# Related:
# - documentation/api/FRONTEND-BACKEND-HTTP.md
# - docker/scripts/eliteew-stack0-baked-deploy.sh (--refresh-openapi-pilots)
# ---

DOCKER_NETWORK=eliteew_openapi_export
HOST_IP=127.0.0.1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_EXTERNAL_PORT=9200
CHROMADB_CONTAINER_NAME=chroma
CHROMADB_HOST=127.0.0.1
CHROMADB_EXTERNAL_HOST=127.0.0.1
CHROMADB_PORT=8000
CHROMADB_EXTERNAL_PORT=8000
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_EXTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_CONTAINER_NAME=rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_EXTERNAL_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_EXTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_VHOST=/
QDRANT_CONTAINER_NAME=qdrant
QDRANT_HOST=127.0.0.1
QDRANT_EXTERNAL_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_EXTERNAL_PORT=6333
QDRANT_GRPC_PORT=6334

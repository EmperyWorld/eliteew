# ============================================================================
# Stack3 — мониторинг (Prometheus, Alertmanager, VictoriaLogs, Vector).
# Сейчас стек не используется: все переменные закомментированы (шаблон на будущее).
# ============================================================================
# Скопируй в .env.stack3, раскомментируй и заполни. В compose нет дефолтов.
# Запуск: docker compose -f docker/stack/stack3.yml --env-file docker/env_file/.env.stack3 up -d
#
# UI: Prometheus http://127.0.0.1:<STACK3_PROMETHEUS_HOST_PORT>/
#     VictoriaLogs http://127.0.0.1:<STACK3_VICTORIALOGS_HOST_PORT>/
#     Alertmanager http://127.0.0.1:<STACK3_ALERTMANAGER_HOST_PORT>/
# ============================================================================

# --- Сеть (compose создаст при первом up) ---
# STACK3_NETWORK_NAME=ew_net_monitor

# --- Пользователь контейнеров (non-root) ---
# STACK3_USER=1000:1000

# --- Образы (только официальные репозитории) ---
# STACK3_PROMETHEUS_IMAGE=docker.io/prom/prometheus:v2.47.2
# STACK3_ALERTMANAGER_IMAGE=docker.io/prom/alertmanager:v0.26.0
# STACK3_VICTORIALOGS_IMAGE=docker.io/victoriametrics/victoria-logs:v1.48.0
# STACK3_VECTOR_IMAGE=docker.io/timberio/vector:0.34.1-alpine

# --- Prometheus ---
# STACK3_PROMETHEUS_BIND_ADDRESS=127.0.0.1
# STACK3_PROMETHEUS_HOST_PORT=30011
# STACK3_PROMETHEUS_RETENTION=15d

# --- Alertmanager ---
# STACK3_ALERTMANAGER_BIND_ADDRESS=127.0.0.1
# STACK3_ALERTMANAGER_HOST_PORT=30012

# --- VictoriaLogs ---
# STACK3_VICTORIALOGS_BIND_ADDRESS=127.0.0.1
# STACK3_VICTORIALOGS_HOST_PORT=30013
# STACK3_VICTORIALOGS_RETENTION=7d

# cAdvisor убран из стека (требует privileged/cgroup). При необходимости — отдельный контейнер.

# EliteEW example env — .env.yandex-tunnel.example
# Generated from live staging keys with secrets redacted (Wave env-order 2026-08-15).
# Live SSOT on command-center: docker/env_file/.env.yandex-tunnel
# Pair: docker/stack/stack-yandex-tunnel.yml.
# Do not put real secrets here — commit-safe placeholders only.

# --- Keys referenced by compose (${VAR}) ---
YANDEX_TUNNEL_IMAGE_TAG=
YANDEX_TUNNEL_JVB_MEDIA=1
YANDEX_TUNNEL_JVB_RELAY_TCP_BIND=
YANDEX_TUNNEL_JVB_RELAY_TCP_PORT=13400
YANDEX_TUNNEL_JVB_TCP_REMOTE_PORT=13401
YANDEX_TUNNEL_JVB_TCP_TARGET_PORT=34001
YANDEX_TUNNEL_JVB_UDP_REMOTE_PORT=13400
YANDEX_TUNNEL_JVB_UDP_TARGET=127.0.0.1:34000
YANDEX_TUNNEL_KEY_PATH=
YANDEX_TUNNEL_KNOWN_HOSTS_PATH=
YANDEX_TUNNEL_PROXY=
YANDEX_TUNNEL_USER=tunnel
YANDEX_VM_IP=93.77.165.185

# --- Additional live staging keys (not necessarily in compose) ---
YANDEX_VM_ADMIN_KEY_PATH=CHANGE_ME
YANDEX_VM_ADMIN_USER=eliteew-edge

# --- Air enrollment edge (IDs are not secrets; key paths remain local) ---
# Dedicated SG must be named eliteew_air_enroll_security_group and attached
# only to the canonical edge NIC. Never put the private control key here.
ELITEEW_AIR_ENROLL_SG_ID=
ELITEEW_AIR_ENROLL_INSTANCE_ID=
ELITEEW_AIR_ENROLL_SSH_PUBLIC_KEY_PATH=

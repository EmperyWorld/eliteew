# =============================================================================
# EliteEW stack0 · prod-baked overlay (пример ключей для .env.stack0.backend)
# =============================================================================
# Скопируйте нужные строки в docker/env_file/.env.stack0.backend на punisher (сборка)
# и на prod-core (запуск). Не коммитьте реальный .env.stack0.backend.
#
# Сборка на punisher (старые stack0-*-prod не трогаем):
#   STACK0_PROD_BAKED_TAG=prod-baked-20260610 bash docker/scripts/build-stack0-prod-baked-images.sh
#
# Экспорт образов:
#   bash docker/scripts/export-stack0-prod-baked-images.sh owned@NEW_HOST prod-baked-20260610
# =============================================================================

STACK0_PROD_BAKED_TAG=prod-baked-20260610

STACK0_API_BAKED_IMAGE=eliteew-api:prod-baked-20260610
STACK0_QUEUE_WORKER_BAKED_IMAGE=eliteew-queue-worker:prod-baked-20260610
STACK0_CELERY_WORKER_BAKED_IMAGE=eliteew-celery-worker:prod-baked-20260610
STACK0_CELERY_BEAT_BAKED_IMAGE=eliteew-celery-beat:prod-baked-20260610
STACK0_SITE_STUDIO_WORKER_BAKED_IMAGE=eliteew-site-studio-worker:prod-baked-20260610
STACK0_FRONTEND_BAKED_IMAGE=eliteew-frontend:prod-baked-20260610

STACK0_API_BAKED_CONTAINER_NAME=stack0-eliteew-api-prod-baked
STACK0_QUEUE_WORKER_BAKED_CONTAINER_NAME=stack0-eliteew-api-worker-prod-baked
STACK0_CELERY_WORKER_BAKED_CONTAINER_NAME=stack0-eliteew-celery-worker-prod-baked
STACK0_CELERY_BEAT_BAKED_CONTAINER_NAME=stack0-eliteew-celery-beat-prod-baked
STACK0_SITE_STUDIO_WORKER_BAKED_CONTAINER_NAME=stack0-eliteew-site-studio-worker-prod-baked
STACK0_FRONTEND_BAKED_CONTAINER_NAME=stack0-eliteew-frontend-prod-baked

# prod-core stack2: только llama-chat (embed/rerank остаются на gpu141)
# LLAMA_URL=http://stack2-llama-chat:8080/v1
# LLAMA_EMBEDDING_URL=http://192.168.1.141:…
# RAG_RERANK_BASE_URL=http://192.168.1.141:…
COMFYUI_URL=http://192.168.1.141:31003/

# Sealed Capsule (fail-closed; set real keys; ELITEEW_CAPSULE_DEV_KEYS defaults off)
DESKTOP_CLIENT_CAPSULE_RECIPIENT_PUBLIC_KEY=
DESKTOP_CLIENT_CAPSULE_SIGNING_KEY=
ELITEEW_CAPSULE_DEV_KEYS=0
LLAMA_DEEP_URL=http://192.168.1.136:8080
EWA_DEEP_LLM_ENABLED=0

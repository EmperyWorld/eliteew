# =============================================================================
# stack0 workers на 192.168.1.141 — override поверх .env.stack0.backend
# =============================================================================
# Скопировать: cp docker/env_file/.env.stack0.backend.lan141.example \
#                 docker/env_file/.env.stack0.backend.lan141
# Секреты — в .env.stack0.backend (копия с punisher).
#
# Запуск (на .141):
#   docker compose -f docker/stack/stack0_b_workers_lan.yml \
#     --env-file docker/env_file/.env.stack0.backend \
#     --env-file docker/env_file/.env.stack0.backend.lan141 up -d
# =============================================================================

PUNISHER_LAN_IP=192.168.1.136

POSTGRES_HOST=192.168.1.136
REDIS_HOST=192.168.1.136
RABBITMQ_HOST=192.168.1.136
CHROMADB_HOST=192.168.1.136
QDRANT_HOST=192.168.1.136
MINIO_HOST=192.168.1.136
ELASTICSEARCH_HOST=192.168.1.136

HOST_IP=192.168.1.136
CHROMADB_EXTERNAL_HOST=192.168.1.136
RABBITMQ_EXTERNAL_HOST=192.168.1.136
QDRANT_EXTERNAL_HOST=192.168.1.136

LLAMA_URL=http://192.168.1.136:8080
COMFYUI_URL=http://host.docker.internal:31003/

# Host-published stack1 ports on punisher (LAN clients use these, not 5432/6379)
POSTGRES_EXTERNAL_PORT=30000
REDIS_EXTERNAL_PORT=30001
CHROMADB_EXTERNAL_PORT=30002
QDRANT_EXTERNAL_PORT=30003
QDRANT_HTTP_EXTERNAL_PORT=30004
MINIO_EXTERNAL_PORT=30006
ELASTICSEARCH_EXTERNAL_PORT=30007
RABBITMQ_EXTERNAL_PORT=30008
RABBITMQ_MANAGEMENT_EXTERNAL_PORT=30009
REDIS_PORT=30001
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=6
POSTGRES_MAX_OVERFLOW=6
ASYNCPG_POOL_MIN_SIZE=1
ASYNCPG_POOL_MAX_SIZE=3
RABBITMQ_PORT=5672

DOCKER_NETWORK=ew_net_2847
CHROMADB_CONTAINER_NAME=stack1-chroma
CHROMADB_PORT=8000
RABBITMQ_CONTAINER_NAME=stack1-rabbitmq
RABBITMQ_MANAGEMENT_PORT=15672
QDRANT_CONTAINER_NAME=stack1-qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
MINIO_PORT=8333
MINIO_CONSOLE_PORT=8888
ELASTICSEARCH_PORT=30007

# --- EWA companion async jobs (Phase 1 BO): Celery worker on .141 runs companion_run_task.
EWA_COMPANION_ASYNC_JOBS_ENABLED=1
EWA_COMPANION_ASYNC_MUSIC_ENABLED=1
# WF flags inherited from .env.stack0.backend on deploy; override here if needed.
#EWA_COMPANION_WF_ENGINE_ENABLED=0
#EWA_COMPANION_WF_MUSIC_FULL_V1=0
# EWA Postgres на punisher (не stack1 :30000). На punisher: EWA_POSTGRES_CLIENT_BIND=192.168.1.136
# и firewalld tcp/30433 (setup-punisher-firewalld-lan141.sh). USER/PASS — из .env.stack-ewa.
# EWA_DATABASE_URL=postgresql://ewa_user:CHANGE_ME@192.168.1.136:30433/ewa

# Music celery on .141 calls punisher API (must match punisher API_BIND + firewalld tcp/29000)
ELITEEW_LAN_WORKER_HTTP_BASE_URL=http://192.168.1.136:29000

# Tool-router (LAN bind punisher :8088) — обязательно с gpu141, на punisher можно и через docker DNS
EWA_COMPANION_TOOL_ROUTER_ENABLED=1
EWA_COMPANION_TOOL_ROUTER_MODE=partial
EWA_COMPANION_TOOL_ROUTER_URL=http://192.168.1.136:8088
EWA_COMPANION_TOOL_ROUTER_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
AWS_S3_ENDPOINT=http://192.168.1.136:30006

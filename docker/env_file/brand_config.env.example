STACK9_F5_TTS_IMAGE=ew_f5_tts:base-v1
STACK_YANDEX_TUNNEL_IMAGE=eliteew-yandex-tunnel:prod

VOLUME_POSTGRES_DATA=eliteew_postgres_data

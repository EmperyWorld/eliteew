# EliteEW production brand and Podman naming contract.
# Copy to brand_config.env (same directory or repo root) and fill CHANGE_ME values before portable release deploy.
# Format: POSIX dotenv KEY=value, no shell command substitution.

# -----------------------------------------------------------------------------
# Brand identity
# -----------------------------------------------------------------------------
# Product display name shown in logs, labels and release docs.
BRAND_PRODUCT_NAME=EliteEW
# Company display name.
BRAND_COMPANY_NAME=Empery World
# Canonical company URL with scheme.
BRAND_COMPANY_SITE=https://eliteew.ru
# Author label for generated release artifacts.
BRAND_AUTHOR_LABEL=po&T && TZBrand
# Default timezone for Fedora host and containers.
BRAND_TIMEZONE=Asia/Vladivostok

# -----------------------------------------------------------------------------
# Public domains and OIDC naming
# -----------------------------------------------------------------------------
# Root domain used by frontend, edge, Keycloak, Jitsi and Site Studio.
BRAND_ROOT_DOMAIN=eliteew.ru
BRAND_APP_ORIGIN=https://app.eliteew.ru
BRAND_APP_WS_ORIGIN=wss://app.eliteew.ru
BRAND_AUTH_ORIGIN=https://auth.eliteew.ru
BRAND_MEET_ORIGIN=https://meet.eliteew.ru
BRAND_SITES_BASE_DOMAIN=sites.eliteew.ru
BRAND_KEYCLOAK_REALM=empery
BRAND_KEYCLOAK_API_CLIENT_ID=empery-api
BRAND_KEYCLOAK_WEB_CLIENT_ID=empery-web
BRAND_KEYCLOAK_MOBILE_CLIENT_ID=empery-mobile
BRAND_JITSI_APP_NAME=EliteEW Meet
BRAND_JITSI_PROVIDER_NAME=Empery World
BRAND_MOBILE_APK_NAME=empery-mobile.apk

# -----------------------------------------------------------------------------
# Release paths
# -----------------------------------------------------------------------------
# deploy.sh rewrites RELEASE_ROOT to the current directory when empty.
RELEASE_ROOT=
RELEASE_STATE_DIR=./state
RELEASE_LOG_DIR=./logs
RELEASE_SECRETS_DIR=./secrets
RELEASE_MODELS_DIR=/home/owned/models
RELEASE_LOCAL_BINARIES_DIR=./local/binaries

# -----------------------------------------------------------------------------
# Podman compose, images, containers and networks
# -----------------------------------------------------------------------------
RELEASE_COMPOSE_PROJECT_NAME=eliteew-prod
INFRA_STACK_PREFIX=stack
INFRA_SERVICE_BRAND_PREFIX=eliteew
INFRA_NETWORK_PREFIX=ew_net

NET_PUBLIC=ew_net_6211
NET_DATA=ew_net_2847
NET_AUTH=ew_net_9O11
NET_LLM=ew_net_4532
NET_DOCS=ew_net_7198
NET_VOICE=ew_net_3365
NET_MEET=ew_net_5402
NET_MONITOR=ew_net_monitor
STACK12_INTERNAL_NETWORK=stack12-internal
STACK12_DOCKER_SUBNET=10.89.12.0/24
STACK12_DNS_CONTAINER_IP=10.89.12.53

STACK0_API_IMAGE=eliteew-api:prod
STACK0_QUEUE_WORKER_IMAGE=eliteew-queue-worker:prod
STACK0_CELERY_WORKER_IMAGE=eliteew-celery-worker:prod
STACK0_CELERY_BEAT_IMAGE=eliteew-celery-beat:prod
STACK0_FRONTEND_IMAGE=eliteew-frontend-fedora:prod
STACK0_API_CONTAINER_NAME=stack0-eliteew-api-prod
STACK0_API_WORKER_CONTAINER_NAME=stack0-eliteew-api-worker-prod
STACK0_CELERY_WORKER_CONTAINER_NAME=stack0-eliteew-celery-worker-prod
STACK0_CELERY_BEAT_CONTAINER_NAME=stack0-eliteew-celery-beat-prod
STACK0_FRONTEND_CONTAINER_NAME=stack0-eliteew-frontend-prod

STACK1_POSTGRES_CONTAINER_NAME=stack1-postgres
STACK1_REDIS_CONTAINER_NAME=stack1-redis

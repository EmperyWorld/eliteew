# -----------------------------------------------------------------------------
# Unix users for rootless Podman containers
# -----------------------------------------------------------------------------
STACK0_USER=1000:1000
STACK0_FRONTEND_USER=0:0
STACK1_UID_DB=999:999
STACK1_UID_APP=1000:1000
STACK1_UID_SEARCH=1000:1000
STACK2_LLAMA_USER=0:0
STACK4_USER=1000:1000
STACK6_KEYCLOAK_USER=1000:0
STACK6_KEYCLOAK_POSTGRES_USER=999:999
STACK9_USER=1000:1000
EWA_PG_UID=1000:1000

# -----------------------------------------------------------------------------
# Application secrets and database URLs
# Replace every CHANGE_ME before production use.
# -----------------------------------------------------------------------------
POSTGRES_DB=ai_services
POSTGRES_USER=eliteew
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_HOST=stack1-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://eliteew:CHANGE_ME_POSTGRES_PASSWORD@stack1-postgres:5432/ai_services
REDIS_HOST=stack1-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ_PASSWORD
EWA_POSTGRES_DB=ewa_platform
EWA_POSTGRES_USER=ewa
EWA_POSTGRES_PASSWORD=CHANGE_ME_EWA_POSTGRES_PASSWORD
EWA_DATABASE_URL=postgresql+asyncpg://ewa:CHANGE_ME_EWA_POSTGRES_PASSWORD@stack-ewa-postgres:5432/ewa_platform
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KC_HOSTNAME=https://auth.eliteew.ru
KC_HOSTNAME_ADMIN=https://auth.eliteew.ru
MINIO_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
JITSI_APP_SECRET=CHANGE_ME_JITSI_APP_SECRET
JITSI_JWT_APP_ID=eliteew
JITSI_JWT_APP_SECRET=CHANGE_ME_JITSI_JWT_SECRET
YANDEX_VM_IP=CHANGE_ME_EDGE_VM_IP
YANDEX_TUNNEL_USER=tunnel
YANDEX_TUNNEL_KEY_PATH=./secrets/yandex_tunnel_key
YANDEX_TUNNEL_KNOWN_HOSTS_PATH=./secrets/yandex_known_hosts

# -----------------------------------------------------------------------------
# Stack0 runtime contract used by docker/builders/stack0-api/scripts/start_all.sh
# -----------------------------------------------------------------------------
STACK0_RUNTIME_HOME=/tmp/eliteew-stack0
STACK0_CACHE_DIR=/tmp/eliteew-stack0/cache
STACK0_ONNX_HOME=/tmp/eliteew-stack0/onnx
STACK0_HF_HOME=/tmp/eliteew-stack0/hf
STACK0_PYTHON_VENV=/opt/venv
STACK0_DOC_BUILDER_REL=docker/builders/stack0-api
STACK0_DOC_REQUIREMENTS_REL=docker/builders/stack0-api/requirements
STACK0_DOC_DOCFILE_REL=docker/builders/stack0-api/Dockerfile
STACK0_DOC_RUNTIME_LAYER_HINT=runtime-base
STACK0_DOC_ENV_FILE_HINT=brand_config.env
STACK0_DOC_REDIS_HOST_HINT=REDIS_HOST
STACK0_DOC_STACK1_HINT=podman-compose.prod.yml: stack1 services
STACK0_DOC_STACK4_HINT=podman-compose.prod.yml: stack4 profile
STACK0_DOC_WHISPER_BACKEND_HINT=stack9-whisper-fast
STACK0_LL_HTTP_HEALTH_SUFFIX=/health
STACK0_TIKA_HTTP_HEALTH_SUFFIX=/
STACK0_FFMPEG_BIN=/usr/bin/ffmpeg
STACK0_TCP_PROBE_TIMEOUT_SEC=2
STACK0_REDIS_FORBIDDEN_HOSTS=localhost,127.0.0.1,0.0.0.0
STACK0_PYTORCH_CUDA_PROBE=0
STACK0_DOC_VOICE_TRANSCRIBE_ENDPOINT=/api/v1/voice-gateway/transcribe
STACK0_DOC_LLM_OVERVIEW_REL=documentation/platform/docker-re_doc/STACK0-LLM-OVERVIEW.md
STACK0_PACKAGE_IMPORT_CHECKLIST=api.main,api.core.unified_config,api.tasks.celery_app
STACK0_UVICORN_TIMEOUT_KEEP_ALIVE=75
STACK0_UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30
STACK0_REMOVE_PYC_ON_START=1
STACK0_REDIS_FLUSHALL_ON_START=0
GENERATED_FILES_BASE=/app
PYTHONDONTWRITEBYTECODE=1
PYTHONPYCACHEPREFIX=
ELITEEW_LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=info
PLAYWRIGHT_BROWSERS_PATH=/app/playwright-browsers

# -----------------------------------------------------------------------------
# Feature toggles and internal service URLs
# -----------------------------------------------------------------------------
ENABLE_RABBITMQ=true
ENABLE_QUEUE_UGS=true
ENABLE_QUEUE_DOCS=true
ENABLE_QUEUE_NOTIFICATIONS=true
ENABLE_QUEUE_EWRP=true
ENABLE_QUEUE_BI=true
ENABLE_QUEUE_VOICE=true
ENABLE_QUEUE_SITE_STUDIO=true
ENABLE_QUEUE_NOTIFICATIONS_WORKER=true
ELITEEW_SITE_STUDIO_ALLOW_INLINE_FALLBACK=false
LLAMA_URL=http://stack2-llama-chat:8080
LLAMA_MODEL=default
LLAMA_EMBEDDING_URL=http://stack2-llama-embed:8080
LLAMA_EMBEDDING_MODEL=default
QDRANT_URL=http://stack1-qdrant:6333
CHROMADB_HOST=stack1-chroma
CHROMADB_PORT=8000
ELASTICSEARCH_URL=http://stack1-elasticsearch:9200
MINIO_ENDPOINT=http://stack1-seaweedfs:8333
SILERO_SERVICE_URL=http://stack9-cosyvoice3:8000
TIKA_URL=http://stack4-tika:9998
WHISPER_ENABLED=true
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BATCH_SIZE=16
WHISPER_MODEL_DIR=/app/models
WHISPER_VAD_FILTER=true
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ru
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
CUDA_HOME=/usr/local/cuda
PYTORCH_ALLOC_CONF=max_split_size_mb:512
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
ANONYMIZED_TELEMETRY=false

# -----------------------------------------------------------------------------
# LLM, voice and optional profile inputs (weights outside monorepo)
# -----------------------------------------------------------------------------
ELITEEW_AI_MODELS_ROOT=/home/owned/models
STACK2_LLAMA_MODELS_PATH=/home/owned/llama-test-models
LLAMA_CHAT_FILE=CHANGE_ME_CHAT_MODEL.gguf
LLAMA_CHAT_MMPROJ_FILE=mmproj-BF16.gguf
LLAMA_EMBED_FILE=CHANGE_ME_EMBED_MODEL.gguf
LLAMA_RERANK_FILE=CHANGE_ME_RERANK_MODEL.gguf
LLAMA_TOOL_ROUTER_FILE=CHANGE_ME_TOOL_ROUTER_MODEL.gguf
WHISPER_MODELS_PATH=/home/owned/models/whisper
F5_TTS_CACHE_PATH=/home/owned/models/tts
STACK9_VOICES_PATH=/home/owned/models/voices

# Compose profiles enabled by deploy.sh. Comma separated.
ELITEEW_RELEASE_PROFILES=local-workers,stack2-local-ai,docs,voice,meet,mobile-release

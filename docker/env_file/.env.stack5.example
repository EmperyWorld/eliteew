# ============================================================================
# Stack5 — SearXNG + Crawl4AI (docker/stack/stack5.yml).
# Сейчас стек не используется: переменные ниже — шаблон (закомментировано).
# ============================================================================
# Запуск (после восстановления compose и раскомментирования):
#   docker compose -f docker/stack/stack5.yml --env-file docker/env_file/.env.stack5 up -d
#
# Сервисы в сети Docker: stack5-searxng:8080, stack5-crawl4ai:11235.
#
# Для EliteEW API (stack0) в docker/env_file/.env.stack0.backend:
#   SEARXNG_URL=http://stack5-searxng:8080
#   CRAWL4AI_URL=http://stack5-crawl4ai:11235
#
# Конфиг SearXNG: docker/stack/stack5/searxng.settings.yml (монтируется read-only).
# ============================================================================

# STACK5_SEARXNG_USER=977:977
# STACK5_CRAWL4AI_USER=1000:1000
# STACK5_SEARXNG_HOST_PORT=8080

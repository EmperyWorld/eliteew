# EliteEW example env — .env.stack-ewa.example
# Generated from live staging keys with secrets redacted (Wave env-order 2026-08-15).
# Live SSOT on command-center: docker/env_file/.env.stack-ewa
# Pair: docker/stack/stack-ewa-postgres.yml.
# Do not put real secrets here — commit-safe placeholders only.

# --- Keys referenced by compose (${VAR}) ---
EWA_PG_TZ=Asia/Vladivostok
EWA_PG_UID=1000:1000
EWA_POSTGRES_CLIENT_BIND=127.0.0.1
EWA_POSTGRES_DB=ewa
EWA_POSTGRES_HOST_PORT=30433
EWA_POSTGRES_PASSWORD=CHANGE_ME
EWA_POSTGRES_USER=ewa_user

# --- Additional live staging keys (not necessarily in compose) ---
EWA_DATABASE_URL=CHANGE_ME


# EliteEW example env — .env.stack6.example
# Generated from live staging keys with secrets redacted (Wave env-order 2026-08-15).
# Live SSOT on command-center: docker/env_file/.env.stack6
# Pair: docker/stack/stack6.yml (+ prod-baked override).
# Do not put real secrets here — commit-safe placeholders only.

# --- Keys referenced by compose (${VAR}) ---
DESKTOP_CLIENT_BINDING_SPI_TOKEN=CHANGE_ME
ELITEEW_BINDING_API_BASE_URL=
ELITEEW_BINDING_INTERNAL_API_BASE_URL=
KC_HOSTNAME=https://auth.eliteew.ru
KC_HOSTNAME_ADMIN=https://auth.eliteew.ru
KC_PROXY_TRUSTED_ADDRESSES=127.0.0.0/8,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
KEYCLOAK_ADMIN=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_HOST_BIND=CHANGE_ME
KEYCLOAK_HOST_PORT=CHANGE_ME
KEYCLOAK_POSTGRES_HOST_PORT=CHANGE_ME
# Baked SPI image on prod-core (required with stack6.prod-baked.override.yml).
# Example: localhost/eliteew-keycloak:prod-stack6-YYYYMMDD-HHMM
STACK6_KEYCLOAK_IMAGE=
STACK6_KEYCLOAK_POSTGRES_USER=CHANGE_ME
STACK6_KEYCLOAK_USER=CHANGE_ME

# --- Additional live staging keys (not necessarily in compose) ---
ELITEEW_KC_ATOMIC_AUTH_ENFORCE=CHANGE_ME
KEYCLOAK_DESKTOP_CLIENT_ID=CHANGE_ME
KEYCLOAK_ENABLE_DEWA_CLIENTS=CHANGE_ME
KEYCLOAK_ENABLE_EWPOWER_CLIENTS=CHANGE_ME
KEYCLOAK_EWPOWER_API_SERVICE_ACCOUNTS=CHANGE_ME
KEYCLOAK_EWPOWER_PUBLIC_URL=CHANGE_ME
KEYCLOAK_FOFLINE_CLIENT_ID=CHANGE_ME
KEYCLOAK_KCADM_USER=CHANGE_ME
KEYCLOAK_WEB_EXTRA_POST_LOGOUT_REDIRECT_URIS=CHANGE_ME
KEYCLOAK_WEB_EXTRA_REDIRECT_URIS=CHANGE_ME
KEYCLOAK_WEB_EXTRA_WEB_ORIGINS=CHANGE_ME


{
  "ignition": {
    "version": "3.4.0"
  },
  "passwd": {
    "users": [
      {
        "groups": [
          "wheel"
        ],
        "name": "siteedge",
        "sshAuthorizedKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPlaceholderReplaceBeforeProvision siteedge@example"
        ]
      }
    ]
  },
  "storage": {
    "directories": [
      {
        "path": "/var/lib/eliteew",
        "mode": 493
      },
      {
        "group": {
          "name": "siteedge"
        },
        "path": "/var/lib/eliteew/site-edge",
        "user": {
          "name": "siteedge"
        },
        "mode": 493
      },
      {
        "group": {
          "name": "siteedge"
        },
        "path": "/var/lib/eliteew/site-edge/images",
        "user": {
          "name": "siteedge"
        },
        "mode": 493
      },
      {
        "path": "/etc/eliteew",
        "mode": 493
      },
      {
        "path": "/etc/eliteew/site-edge",
        "mode": 493
      }
    ],
    "files": [
      {
        "path": "/etc/hostname",
        "contents": {
          "compression": "",
          "source": "data:,site-edge-01"
        },
        "mode": 420
      },
      {
        "path": "/etc/ssh/sshd_config.d/99-edge.conf",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/2yOwUrEUAxF9+8rAm50MWL1C0qpMOhAGRXdxr7wGohJecm0+vdiV4qzPfde7rmAXjiof4UnDtr1uRC4TxkmrJmUtcDlvigHm0KuNu9Yr67TQPWD42gWj1ZYQS0N6L5aze0pJtLgEbeNWnp4z3sNqjgGL/Q/7yYUIS10JJ9N/UzlxWloD/BFnt6a5t7qijX/yKmlVsTW53H+Szth0miFF9rOFxRobm9+885OGgf8hLv0HQAA///SElExBwEAAA=="
        },
        "mode": 420
      },
      {
        "path": "/etc/eliteew/carrier-ready.env",
        "contents": {
          "compression": "",
          "source": "data:,%23%20Copied%20to%20Edge%20at%20first%20boot.%20Names%20only%20%E2%80%94%20no%20secrets.%0ASITE_EDGE_WORKDIR%3D%2Fvar%2Flib%2Feliteew%2Fsite-edge%0ASITE_EDGE_DEFAULT_PUBLISH%3D8080%0A"
        },
        "mode": 420
      },
      {
        "path": "/etc/NetworkManager/system-connections/edge-lan.nmconnection",
        "contents": {
          "compression": "gzip",
          "source": "data:;base64,H4sIAAAAAAAC/3TMvQrDMAxF4f2+S7bSTU9iPIj4phE4UkiVgt++9G/sfD5OmcOdc1p4hTVhu3Hq6sixU5grD2dCz4yvlDxOAuXXKlBsf1wqNuYaTV4Wm45pUeuyaL/zQ65/yHv4DAAA//9KwhFAiQAAAA=="
        },
        "mode": 384
      },
      {
        "path": "/etc/sudoers.d/siteedge-wheel",
        "contents": {
          "compression": "",
          "source": "data:,siteedge%20ALL%3D(ALL)%20NOPASSWD%3A%20ALL%0A"
        },
        "mode": 288
      }
    ]
  },
  "systemd": {
    "units": [
      {
        "contents": "[Unit]\nDescription=EliteEW Site-Edge: layer podman/rsync via rpm-ostree (once)\nConditionPathExists=!/var/lib/eliteew/.edge-packages-done\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/bin/bash -c 'rpm-ostree install -y --allow-inactive podman rsync || rpm-ostree install -y podman rsync'\nExecStart=/bin/mkdir -p /var/lib/eliteew\nExecStart=/bin/touch /var/lib/eliteew/.edge-packages-done\nExecStart=/usr/bin/systemctl reboot\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "rpm-ostree-edge-packages.service"
      },
      {
        "contents": "[Unit]\nDescription=EliteEW Site-Edge: enable linger for siteedge (rootless Podman)\nAfter=local-fs.target systemd-user-sessions.service\nRequires=local-fs.target\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/loginctl enable-linger siteedge\nExecStart=/bin/mkdir -p /var/lib/eliteew/site-edge/images\nExecStart=/bin/chown -R siteedge:siteedge /var/lib/eliteew/site-edge\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n",
        "enabled": true,
        "name": "edge-podman-linger.service"
      }
    ]
  }
}

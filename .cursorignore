# Cursor HARD BLOCK — agent cannot Read/Grep/@ these paths.
# Semantic index exclusion for heavy product trees: .cursorindexingignore (soft block).
# Sentinel layers: universe_map.md (sessionStart), rules/*.mdc (scoped), skill deep-dive.
#
# Syntax: gitignore-style paths from monorepo root powered_by_emperyworld.
# Last matching pattern wins. A parent directory ignore is not traversed —
# do not use `keys/` then `!keys/*.pub` (use `keys/*` + exceptions).
# Nested: shared/web/frontend/.cursorignore (frontend-only workspace).
# Pack layout: shared/ + pack-cloud/ + pack-organization/ + host/ — EliteEW/ retired.
#
# Intentionally readable: .cursor/rules/, .cursor/skills/, .cursor/universe_map.md,
#   documentation/ (except heavy dumps below), docker/stack/, docker/scripts/,
#   docker/builders/, docker/env_file/*.example (+ README/SYNC docs; plaintext env blocked),
#   site-templates/ sources (not node_modules/data/uploads),
#   scripts/, shared/{api,web,apps,packages}/ sources, host/README.md,
#   host/kernel-offline/ (policy SoT), keys/*.pub, keys/README.md.

# --- host/ ops-data (Wave Host-1): heavy runtime — not product mid ---
# Keep host/README.md + host/kernel-offline/ readable (Kernel-offline policy SoT).
host/comfyui/
host/comfyui/**
host/generated_files/
host/generated_files/**
host/runtime/
host/runtime/**

# --- Sentinel hard block (secrets, keys, archives) ---
# Ignore children, not the directory itself, so *.pub / README stay readable.
keys/*
!keys/*.pub
!keys/README.md
trash/
trash/**
trash_reload/
trash_reload/**
brand_config.env
issledovanie/
production_release/
**/production_release/
# site-templates sources stay readable; heavy paths blocked under deps section
# --- Android: source is SOFT-blocked in .cursorindexingignore (Read/@path OK).
#     Do not uncomment a whole-tree pack-cloud/mobile/ hard block.
*.apk
pack-cloud/mobile/**/.cxx/
pack-cloud/mobile/**/build/
pack-cloud/mobile/.gradle/
# --- Архивы, бэкапы, личные деревья (не канон documentation/) ---
*.backup
*.bak
*.tar.gz
*.vsix
backup/
backups/
EliteEW-backup-*.tar
no_index/
ssh-key-*.zip
tg_bot_ip_verif_deploy_READY.tar.gz

# --- Cursor IDE: кэш и расширения (не rules/skills/agents) ---
#.cursor/ext/
#.cursor/extensions/
#.cursor/plans/

# --- Docker: compose/scripts/builders — в индексе; data/logs/env/certs — нет ---
!docker/
!docker/**
.docker/
docker/data/
docker/data/**
# Ignore children, not the directory — keep *.example readable (Config Plane templates).
docker/env_file/*
!docker/env_file/*.example
!docker/env_file/README.md
!docker/env_file/SYNC_STACK0_STACK1.md
docker/logs/
docker/logs/**
docker/offline/certs/
docker/offline/certs/**
docker/whisper-models/
docker/whisper-models/**

# --- Документация: канон documentation/ в индексе; тяжёлые дампы — нет ---
documentation/api/eliteew-openapi-export.json
documentation/archive/
documentation/archive/**
# Handoff-логи сессий (~900 md): hard-block children, not the directory
# (parent-dir ignore is not traversed — same rule as keys/*).
documentation/worklog/session-summaries/*
!documentation/worklog/session-summaries/README.md
!documentation/worklog/session-summaries/AGENT-HANDOFF-INDEX.md
documentation/worklog/session-summaries-05-2026/
documentation/worklog/session-summaries-05-2026/**

# --- Build deploy-id (tracked для stack0 gate; не семантический индекс) ---

# EliteEW install profile packs — env overlays (no secrets)
#
# Merge these keys into stack0 API / compose env for the named pack.
# Secrets (Postgres, Keycloak, Redis, …) stay in customer-owned env files.
#
# Canon: documentation/platform/ELITEEW-ONPREM-TEAM-CORE-PACK.md
# Profile: shared/apps/_profiles/onprem-team-core.yaml

ELITEEW_PRODUCT_EDITION=onprem
ELITEEW_INSTALL_PROFILE=onprem-team-core

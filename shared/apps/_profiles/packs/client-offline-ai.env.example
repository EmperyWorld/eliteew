# Client / offline-capable pack. AI router O3a probes + O3b completions living; Tauri AI panel deferred.
# Canon: documentation/platform/ELITEEW-PRODUCT-EDITIONS-AND-APP-PLATFORM.md §3.4
# Profile: shared/apps/_profiles/client-offline-ai.yaml
# AI pack: documentation/platform/ELITEEW-CLIENT-OFFLINE-AI-PACK.md

ELITEEW_PRODUCT_EDITION=client
ELITEEW_INSTALL_PROFILE=client-offline-ai

# AI policy (UnifiedConfig — living):
# Empty ELITEEW_AI_PROVIDERS_ALLOWLIST → client default = ai.local only (fail-closed).
# Opt-in remote AI (never default):
# ELITEEW_AI_PROVIDER_DEFAULT=ai.local
# ELITEEW_AI_PROVIDERS_ALLOWLIST=ai.local,ai.third_party,ai.eliteew

# Client remote-tools API hard gate (oauth2 middleware when edition=client):
# Core allow: /api/health, /api/v1/auth, /api/v1/desktop-client, /api/v1/desktop/install-profile, …
# Extra CSV prefixes (optional):
# CLIENT_REMOTE_TOOLS_EXTRA_PREFIXES=/api/v1/desktop/ai-chat
# Manifest client.remote_tools_allowlist tool ids (e.g. llm.eliteew) map to API prefixes at runtime.

# O3a probes (no secrets — URLs only):
# ELITEEW_AI_LOCAL_BASE_URL=http://127.0.0.1:11434
# ELITEEW_AI_LOCAL_MODEL=llama3.2
# ELITEEW_AI_THIRD_PARTY_BASE_URL=https://api.openai.com/v1
# ELITEEW_AI_THIRD_PARTY_MODEL=gpt-4o-mini
# ai.eliteew uses existing LLAMA_URL / platform llama_url

# O3b completions (ops/customer env only — never commit real keys):
# ELITEEW_AI_THIRD_PARTY_API_KEY=
# Tauri O3d prefers OS keyring; env is read-only fallback for the native client.

# O3e EliteEW platform LLM (Tauri — not baked publicly by default):
# ELITEEW_AI_ELITEEW_BASE_URL=https://…   # or LLAMA_URL
# ELITEEW_AI_ELITEEW_MODEL=…              # or LLAMA_MODEL

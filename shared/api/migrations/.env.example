# Секреты подключения к PostgreSQL для скрипта apply_migrations.sh
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# Файл .env не коммитится в репозиторий (.gitignore).

# --- Режим: через Docker (1) или напрямую psql по DATABASE_URL (0)
USE_DOCKER=1

# --- Параметры для режима Docker (USE_DOCKER=1)
# ELITEEW_CONTAINER_RUNTIME=podman
POSTGRES_CONTAINER=stack1-postgres
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=ai_services

# --- Ключ PII (обязателен для миграций с INSERT/UPDATE в users; совпадает с ENCRYPTION_MASTER_KEY API / stack0)
# ENCRYPTION_MASTER_KEY=

# --- Параметры для режима psql (USE_DOCKER=0)
# DATABASE_URL=postgresql://ai_user:your_password_here@localhost:5432/ai_services

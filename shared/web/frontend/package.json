    "test:socket-self-heal": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --maxWorkers=1 src/services/auth/__tests__/socketIoClientPolicy.test.ts src/services/auth/__tests__/authenticatedSocketAuth.test.ts src/services/communication/__tests__/emperyworldSocketService.selfHeal.test.ts src/hooks/__tests__/useSocketConnection.selfHeal.test.ts",

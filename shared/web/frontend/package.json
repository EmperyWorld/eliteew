    "test:content-download-resilience": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --maxWorkers=1 src/services/content/contentDownloadResilience.test.ts src/services/contentApi.downloads.test.ts",
    "test:boot-layout-resilience": "NODE_OPTIONS='--max-old-space-size=4096' vitest run --maxWorkers=1 src/pages/Desktop/utils/__tests__/desktopAppWindowBodyLayoutSync.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterLayoutScheduling.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterViewportScope.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterTransition.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterConvergence.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterStressCoalescing.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterDomContract.test.ts src/components/UltimateDocEditor/EditorCore/tiptapGutterVisualContinuity.test.ts",

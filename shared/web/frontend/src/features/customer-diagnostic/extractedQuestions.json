{"archetype":[{"id":1,"text":"Что лучше всего описывает миссию вашего бренда?","description":"Выберите вариант, который наиболее точно отражает основную цель вашего бренда","options":[{"value":1,"text":"Делать мир проще и добрее"},{"value":2,"text":"Помогать людям открывать новые возможности"},{"value":3,"text":"Предоставлять знания и понимание"},{"value":4,"text":"Помогать людям достигать целей"},{"value":5,"text":"Революционизировать отрасль"}]},{"id":2,"text":"Какие эмоции должен вызывать ваш бренд?","description":"Подумайте о том, какие чувства вы хотите пробудить у ваших клиентов","options":[{"value":1,"text":"Спокойствие и доверие"},{"value":2,"text":"Волнение и приключения"},{"value":3,"text":"Уважение и восхищение"},{"value":4,"text":"Вдохновение и мотивацию"},{"value":5,"text":"Удивление и восторг"}]},{"id":3,"text":"Как ваш бренд решает проблемы клиентов?","description":"Выберите подход, который наиболее характерен для вашего бренда","options":[{"value":1,"text":"Предлагаем простые и понятные решения"},{"value":2,"text":"Даем свободу выбора и самостоятельности"},{"value":3,"text":"Предоставляем экспертную информацию"},{"value":4,"text":"Помогаем преодолеть препятствия"},{"value":5,"text":"Трансформируем подход к проблеме"}]},{"id":4,"text":"Какой стиль коммуникации характерен для вашего бренда?","description":"Подумайте о том, как ваш бренд общается с аудиторией","options":[{"value":1,"text":"Дружелюбный и открытый"},{"value":2,"text":"Энергичный и вдохновляющий"},{"value":3,"text":"Авторитетный и информативный"},{"value":4,"text":"Мотивирующий и поддерживающий"},{"value":5,"text":"Креативный и неожиданный"}]},{"id":5,"text":"Что является главной ценностью вашего бренда?","description":"Выберите основную ценность, которая движет вашим брендом","options":[{"value":1,"text":"Честность и прозрачность"},{"value":2,"text":"Свобода и независимость"},{"value":3,"text":"Знания и мудрость"},{"value":4,"text":"Достижения и успех"},{"value":5,"text":"Инновации и прогресс"}]},{"id":6,"text":"Как ваш бренд относится к традициям?","description":"Определите позицию вашего бренда относительно установленных норм","options":[{"value":1,"text":"Уважаем и следуем проверенным традициям"},{"value":2,"text":"Ищем новые пути, оставаясь верными ценностям"},{"value":3,"text":"Изучаем традиции, чтобы лучше понимать настоящее"},{"value":4,"text":"Берем лучшее из традиций для достижения целей"},{"value":5,"text":"Создаем новые традиции и стандарты"}]},{"id":7,"text":"Какую роль играет эстетика в вашем бренде?","description":"Оцените важность визуального аспекта для вашего бренда","options":[{"value":1,"text":"Простая и понятная красота"},{"value":2,"text":"Естественная и аутентичная эстетика"},{"value":3,"text":"Классическая и утонченная элегантность"},{"value":4,"text":"Мощная и впечатляющая визуализация"},{"value":5,"text":"Уникальная и инновационная эстетика"}]},{"id":8,"text":"Как ваш бренд мотивирует сотрудников?","description":"Подумайте о том, что вдохновляет вашу команду","options":[{"value":1,"text":"Создание дружелюбной рабочей атмосферы"},{"value":2,"text":"Предоставление возможностей для роста"},{"value":3,"text":"Обучение и развитие профессиональных навыков"},{"value":4,"text":"Постановка амбициозных целей"},{"value":5,"text":"Поощрение творчества и инноваций"}]},{"id":9,"text":"Какой тип клиентов привлекает ваш бренд?","description":"Определите основную целевую аудиторию вашего бренда","options":[{"value":1,"text":"Люди, ценящие простоту и качество"},{"value":2,"text":"Искатели приключений и новых впечатлений"},{"value":3,"text":"Эксперты и профессионалы в своей области"},{"value":4,"text":"Амбициозные и целеустремленные личности"},{"value":5,"text":"Творческие и нестандартно мыслящие люди"}]},{"id":10,"text":"Как ваш бренд реагирует на кризисы?","description":"Выберите стратегию поведения в сложных ситуациях","options":[{"value":1,"text":"Остаемся спокойными и прозрачными"},{"value":2,"text":"Ищем новые возможности в вызовах"},{"v
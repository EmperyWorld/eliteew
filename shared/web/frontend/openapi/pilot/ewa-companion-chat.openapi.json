{
  "openapi": "3.1.0",
  "info": {
    "title": "EWA companion chat operations (frontend pilot, wave 9)",
    "version": "1.0.0",
    "description": "Hand-maintained slice for companion chat SSE stream (`POST /api/v1/ewa/companion-chat/stream`), task-run operations (`/api/v1/ewa/companion-chat/task-runs*`), and structured action notices. Mirrors `companion_chat.py` + `gateways/routers/companion_chat.py` + `companion/turn/chat_turn.py` (`iter_companion_chat_stream`). Regenerate TS: `pnpm run openapi:pilot:ewa-companion-chat`."
  },
  "paths": {
    "/api/v1/ewa/companion-chat/stream": {
      "post": {
        "tags": [
          "EWA - Companion chat"
        ],
        "operationId": "ewa_companion_chat_stream",
        "summary": "Companion chat (streaming): one user message → SSE delta + final reply",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanionChatMessageIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`text/event-stream` — SSE blocks `event: <name>\\ndata: <json>\\n\\n` plus `: keep-alive` (~2 s). Primary chat events: **delta** → CompanionChatStreamDelta; **final** → CompanionChatStreamFinal (includes surface_blocks / CompanionSurfaceBlockOut); **actions** → CompanionChatStreamActions; **error** → CompanionChatStreamError; **done** → CompanionChatStreamDone.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CompanionChatStreamDelta"
                    },
                    {
                      "$ref": "#/components/schemas/CompanionChatStreamFinal"
                    },
                    {
                      "$ref": "#/components/schemas/CompanionChatStreamActions"
                    },
                    {
                      "$ref": "#/components/schemas/CompanionChatStreamError"
                    },
                    {
                      "$ref": "#/components/schemas/CompanionChatStreamDone"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. empty message without image)"
          },
          "503": {
            "description": "EWA Postgres pool unavailable"
          }
        }
      }
    },
    "/api/v1/ewa/companion-chat/task-runs": {
      "get": {
        "tags": [
          "EWA - Companion chat"
        ],
        "operationId": "ewa_companion_chat_task_runs_list",
        "summary": "Companion chat operations: list recent task runs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "include_steps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest durable companion task runs for the current principal (active first)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanionTaskRunsOut"
                }
              }
            }
          },
          "503": {
            "description": "EWA Postgres pool unavailable"
          }
        }
      }
    },
    "/api/v1/ewa/companion-chat/task-runs/{run_id}/confirm": {
      "post": {
        "tags": [
          "EWA - Companion chat"
        ],
        "operationId": "ewa_companion_chat_task_run_confirm",
        "summary": "Companion chat operations: confirm or cancel awaiting task run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanionTaskRunConfirmIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirm/cancel applied; reply/actions for SPA dispatch plus updated run row",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanionTaskRunConfirmOut"
                }
              }
            }
          },
          "404": {
            "description": "Task run not found for principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDetail"
                },
                "examples": {
                  "not_found": {
                    "value": {
                      "detail": "companion_task_run_not_found"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Stale revision or run not awaiting confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpErrorDetail"
                },
                "examples": {
                  "revision_conflict": {
                    "value": {
                      "detail": "companion_task_run_revision_conflict"
                    }
                  },
                  "not_awaiting": {
                    "value": {
                      "detail": "companion_task_run_not_awaiting_confirmation"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. decision not confirm|cancel)"
          },
          "502": {
            "description": "Confirm handler failed to return a task run row"
          },
          "503": {
            "description": "EWA Postgres pool unavailable"
          }
        }
      }
    }
  },
